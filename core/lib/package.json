        "types": "./dist/config-repo-template.d.mts",
        "import": "./dist/config-repo-template.mjs"
      },
      "./integration-scopes": {
        "types": "./dist/integration-scopes.d.mts",
        "import": "./dist/integration-scopes.mjs"
      },
      "./oauth": {
        "types": "./dist/oauth.d.mts",

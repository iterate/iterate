        "types": "./dist/oauth-scopes.d.mts",
        "import": "./dist/oauth-scopes.mjs"
      },
      "./project-ingress": {
        "types": "./dist/project-ingress.d.mts",
        "import": "./dist/project-ingress.mjs"
      },

{
  "name": "iterate",
  "version": "0.4.1",
  "description": "SDK and CLI for Iterate",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iterate/iterate",
    "directory": "core/lib"
  },
  "homepage": "https://github.com/iterate/iterate#readme",

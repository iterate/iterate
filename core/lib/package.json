  "files": [
    "bin",
    "dist",
    "menubar",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.cli.json",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "capnweb": "catalog:",
    "json5": "catalog:",
    "oauth4webapi": "catalog:",
    "trpc-cli": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",

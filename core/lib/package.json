      "./app-session": {
        "types": "./dist/app-session.d.mts",
        "import": "./dist/app-session.mjs"
      },
      "./client": {
        "types": "./dist/client.d.mts",
        "import": "./dist/client.mjs"
      },
      "./react": {
        "types": "./dist/react.d.mts",
        "import": "./dist/react.mjs"
      },
      "./api": {
        "types": "./dist/api.d.mts",
        "import": "./dist/api.mjs"
      },
      "./lib": {
        "types": "./dist/lib.d.mts",
        "import": "./dist/lib.mjs"
      },
      "./expression": {
        "types": "./dist/expression.d.mts",

    "./config-repo-template": "./src/config-repo-template.ts",
    "./integration-scopes": "./src/integration-scopes.ts",
    "./oauth": "./src/client/oauth.ts",
    "./stream/run": "./src/stream/run.ts",
    "./email": "./src/email.ts",
    "./node": "./src/node.ts"

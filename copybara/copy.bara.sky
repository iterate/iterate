# ONE-WAY COPIES OF PARTS OF THIS REPO, one Copybara workflow per copy (tasks/copybara0929-experiment.md):
#
#   os         iterate/os0929: apps/os and packages/iterate, today's stand-ins for core/os and
#              core/lib (the call's `iterate/os` is `core/`)
#   packages   iterate/packages0929: every other package
#
# Each copy keeps this repo's paths, so a path means the same file in both. `copybara/<name>/` holds
# the files that exist only at that copy's root (README.md, and later LICENSE or .github/), moved there
# verbatim. Copybara only reads a config named copy.bara.sky, so all copies share this one file.
#
# Every commit that touches a copy's files becomes one copy commit, ending in a
# `GitOrigin-RevId: <origin sha>` trailer. A run copies whatever came after the newest trailer, so a
# missed run is caught up by the next one. scripts/ci/copybara.ts runs both after a deploy.

# The copy's message: the title, its `(#123)` pointing at the iterate/iterate PR, then only the
# paragraphs a PR body wraps in `<!-- copybara -->` … `<!-- /copybara -->`, each marker on a line of
# its own (one mentioned mid-sentence is text). A section with no closing marker is left out. A
# squash merge's message is the PR's title and body, and HTML comments survive into it, as the
# loc-report and os-preview sections do.
def copy_message(ctx):
    lines = ctx.message.split("\n")
    title = re2.compile(" \\(#([0-9]+)\\)$").matcher(lines[0]).replace_all(" (iterate/iterate#$1)")
    sections = []
    section = None
    for line in lines[1:]:
        if line.strip() == "<!-- copybara -->":
            section = []
        elif line.strip() == "<!-- /copybara -->" and section != None:
            if "\n".join(section).strip():
                sections.append("\n".join(section).strip())
            section = None
        elif section != None:
            section.append(line)
    ctx.set_message("\n\n".join([title] + sections) + "\n")

def copy_workflow(name, repo, files, exclude = []):
    core.workflow(
        name = name,
        origin = git.origin(
            url = "https://github.com/iterate/iterate",
            # the default ref; scripts/ci/copybara.ts always names the commit to copy up to
            ref = "main",
            # fetch only what origin_files matches: iterate/iterate is 1.25 GB
            partial_fetch = True,
        ),
        origin_files = glob(files + ["copybara/%s/**" % name], exclude = exclude),
        destination = git.destination(
            url = "https://github.com/iterate/%s" % repo,
            push = "main",
            fetch = "main",
        ),
        destination_files = glob(["**"]),
        mode = "ITERATIVE",
        authoring = authoring.pass_thru("iterate[bot] <233973017+iterate[bot]@users.noreply.github.com>"),
        transformations = [
            core.move("copybara/%s" % name, ""),
            copy_message,
        ],
    )

copy_workflow(
    name = "os",
    repo = "os0929",
    files = ["apps/os/**", "packages/iterate/**"],
)
copy_workflow(
    name = "packages",
    repo = "packages0929",
    files = ["packages/**"],
    exclude = ["packages/iterate/**"],
)

{
  // project-seed.ts and its test import worker code (core/os/src), so they typecheck the way
  // core/os's tests do (its tsconfig.tests.json): Workers types and node's, no DOM lib.
  // ../tsconfig.json leaves them out.
  "extends": "../../core/os/tsconfig.json",
  "compilerOptions": { "types": ["@cloudflare/workers-types", "node"] },
  "include": ["project-seed*.ts"]
}

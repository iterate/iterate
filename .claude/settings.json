{
  "SessionStart": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "DOPPLER_CONFIG=dev_claude \"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/async-coding-agent-setup.sh"
        }
      ]
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-$PWD}\"/scripts/hooks/pr-guidance-gate.sh"
          }
        ]
      }
    ]
  }
}

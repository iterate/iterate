#!/bin/sh

# Coding agents may not `git commit --amend`: an amend rewrites a commit that may already be pushed or
# reviewed, where a new commit keeps the history. Rebasing stays allowed, because updating a PR branch
# (the rebase-pr skill, `git pull` with pull.rebase) is how agents keep work current.
#
# packages/iterate/src/coding-agent.ts is the one list of agent markers, shared with the iterate CLI
# and lint-staged.config.cjs. Git runs hooks from the root of the working tree
# (https://git-scm.com/docs/githooks#_description), so the relative import resolves.
committer=$(node --input-type=module -e 'import { isCodingAgent } from "./packages/iterate/src/coding-agent.ts"; console.log(isCodingAgent(process.env) ? "agent" : "person")') || exit 1
[ "$committer" = "person" ] && exit 0

# $2 is the commit message's source and $3 a commit: `git commit --amend` passes "commit HEAD", while
# -c/-C <commit> reuse a message for a new commit and pass <commit> as typed, so `-C HEAD` is blocked
# too; name the commit by its sha (https://git-scm.com/docs/githooks#_prepare_commit_msg).
# `--amend -m` passes "message" and no commit, so for it read the arguments of the git process that
# runs this hook: the nearest ancestor that is git, past husky's `sh` wrappers. Only that one, since
# a shell further up may mention `--amend` in text that is not the commit.
is_amend=""
if [ "$2" = "commit" ] && [ "$3" = "HEAD" ]; then
  is_amend="yes"
fi
pid=$PPID
while [ -z "$is_amend" ] && [ -n "$pid" ] && [ "$pid" != "1" ]; do
  args=$(ps -o args= -p "$pid")
  case "$args" in
    git\ * | */git\ *)
      case " $args " in *" --amend "*) is_amend="yes" ;; esac
      break
      ;;
  esac
  pid=$(ps -o ppid= -p "$pid" | tr -d ' ')
done

if [ "$is_amend" = "yes" ]; then
  echo "ERROR: AI agents are not allowed to use --amend (rewrites history)"
  echo "Create a new commit instead."
  exit 1
fi

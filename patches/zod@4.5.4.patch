diff --git a/v4/core/errors.cjs b/v4/core/errors.cjs
index 2aad9e501e2fda08605845a0679b7341fe821cc9..f6ee70beb9bfbb985a0be9c4f198ac97473e55a6 100644
--- a/v4/core/errors.cjs
+++ b/v4/core/errors.cjs
@@ -66,7 +66,19 @@ const initializer = (inst, def) => {
     // Clear the shared slots; a retained `value` pins the last error's issues.
     _zodDesc.value = undefined;
     _issuesDesc.value = undefined;
-    Object.defineProperty(inst, "message", _messageDesc);
+    // PATCHED (iterate): materialize the message as an own data property at
+    // construction instead of installing the shared lazy accessor. The lazy
+    // getter leaves the Error's internal message slot empty, so structuredClone
+    // and Cloudflare Workers RPC serialize the error with NO message — callers
+    // across a DO/RPC hop saw bare "ZodError" instead of the validation issues.
+    // Eager stringify restores zod <=4.4 behavior; the cost lands on failure
+    // paths only.
+    Object.defineProperty(inst, "message", {
+        value: JSON.stringify(def, util.jsonStringifyReplacer, 2),
+        enumerable: true,
+        configurable: true,
+        writable: true,
+    });
     /* `toString` lives as a non-enumerable lazy getter on the shared
      * prototype; on first access it caches a per-instance closure so
      * detached usage still works. */

{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "embeddedLanguageFormatting": "auto",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    ".pnpm-store/",
    "dist/",
    "build/",
    ".wrangler/",
    "routeTree.gen.ts",
    "**/.generated/",
    "apps/kit/firmware/components/avatar/src/face_avatar_catalog_generated.inc",
    "packages/ai-linter/src/fixtures/jev-cases.json",
    ".github/workflows/",
    ".git/",
    "**/.claude/worktrees/",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "packages/ui/src/components/ui/alert-dialog.tsx",
    "packages/ui/src/components/ui/avatar.tsx",
    "packages/ui/src/components/ui/badge.tsx",
    "packages/ui/src/components/ui/breadcrumb.tsx",

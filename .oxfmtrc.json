{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "embeddedLanguageFormatting": "auto",
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/ai-engineer-workshop/lib/files.ts",
    "node_modules/",
    ".pnpm-store/",
    "dist/",
    "build/",
    ".next/",
    ".wrangler/",
    "routeTree.gen.ts",
    "config-repo-template.generated.ts",
    "viseme-model.generated.ts",
    "voice-template.generated.ts",
    "apps/kit/firmware/components/avatar/src/face_avatar_catalog_generated.inc",
    "configs/default/prompts/",
    "configs/codemode-tag/prompts/",
    "apps/os/src/domains/agents/prompt-scenarios/*.md",
    "apps/os/src/domains/agents/prompt-scenarios/explainer-shell.html",
    "explainers/prompt-sections.html",
    "worker-configuration.d.ts",
    "apps/auth/wrangler.jsonc",
    "apps/semaphore/wrangler.jsonc",
    "apps/streams-example-app/wrangler.jsonc",
    "logs.json",
    ".github/workflows/",
    ".git/",
    "**/.claude/worktrees/",
    "**/db/migrations/**",
    "**/.corepack/**",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "**/.repomix-*",
    "**/.iterate/",
    "**/components/ui/",
    "**/components/ai-elements/",
    "apps/os/wrangler.jsonc"
  ]
}

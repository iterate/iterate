{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "embeddedLanguageFormatting": "auto",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    ".pnpm-store/",
    "dist/",
    "build/",
    ".next/",
    ".wrangler/",
    "routeTree.gen.ts",
    "config-repo-template.generated.ts",
    "viseme-model.generated.ts",
    "voice-template.generated.ts",
    "apps/kit/firmware/components/avatar/src/face_avatar_catalog_generated.inc",
    "worker-configuration.d.ts",
    "logs.json",
    ".github/workflows/",
    ".git/",
    "**/.claude/worktrees/",
    "**/db/migrations/**",
    "**/.corepack/**",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "**/.repomix-*",
    "**/.iterate/",
    "**/components/ui/",
    "**/components/ai-elements/",
    "apps/browser-extension/capnweb.js",
    "apps/os-next/public/capnweb.js",
    "configs-next/with-agents/agents.js"
  ]
}

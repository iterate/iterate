{
  "name": "@iterate-com/env-manager",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "~/*": "./src/*"
  },
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "cli": "tsx ./scripts/cli.ts",
    "deploy": "tsx ./scripts/deploy.ts",
    "dev": "vite dev",
    "sync-auth-client": "tsx ./scripts/sync-auth-client.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm typecheck && vitest run --config vitest.config.ts --reporter=default --reporter=../../packages/shared/src/test-support/e2e-policy/retry-telemetry-reporter.ts"
  },
  "dependencies": {
    "@distilled.cloud/cloudflare": "0.30.2",
    "@iterate-com/auth": "workspace:*",
    "@iterate-com/auth-contract": "workspace:*",
    "@iterate-com/shared": "workspace:*",
    "@iterate-com/ui": "workspace:*",
    "@tanstack/react-router": "1.170.15",
    "@tanstack/react-start": "1.168.25",
    "alchemy": "2.0.0-beta.66",
    "capnweb": "npm:@iterate-com/capnweb@^0.10.0",
    "effect": "4.0.0-beta.102",
    "iterate": "workspace:*",
    "lucide-react": "^0.553.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:cloudflare",
    "@cloudflare/workers-types": "catalog:cloudflare",
    "@effect/platform-node": "4.0.0-beta.102",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "4.0.15",
    "wrangler": "catalog:cloudflare",
    "ws": "8.19.0"
  }
}

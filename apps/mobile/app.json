{
  "expo": {
    "name": "Iterate Voice",
    "slug": "iterate-voice",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "iterate-voice",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0b0f",
    "ios": {
      "bundleIdentifier": "com.iterate.voice",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Voice sessions stream your microphone to the realtime voice assistant.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0b0f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

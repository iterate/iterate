{
  "expo": {
    "name": "Iterate",
    "slug": "iterate",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "iterate",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0b0f",
    "ios": {
      "bundleIdentifier": "com.iterate.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-dev-client",
      [
        "react-native-enriched-markdown",
        {
          "enableMath": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0b0f",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Iterate syncs the screenshots you choose into your project so you can search them by content."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cfe38002-5822-4465-94d4-7223a2002280"
      }
    },
    "owner": "mishanustom",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/cfe38002-5822-4465-94d4-7223a2002280"
    }
  }
}

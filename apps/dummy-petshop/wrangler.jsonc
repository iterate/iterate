// The fake third party os-next's tests connect to over the real network. The prd account's
// workers.dev subdomain is `iterate`, so this worker serves https://dummy-petshop.iterate.workers.dev.
// No routes, no DNS, no custom domain.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dummy-petshop",
  "account_id": "04b3b57291ef2626c6a8daa9d47065a7",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-06-17",
  "workers_dev": true,
  // Declarative Durable Object lifecycle: Cloudflare reconciles this against the live namespaces on
  // every deploy, so there are no migration tags.
  "exports": { "PetshopStateDurableObject": { "type": "durable-object", "storage": "sqlite" } },
  "durable_objects": {
    "bindings": [{ "name": "PETSHOP_STATE", "class_name": "PetshopStateDurableObject" }],
  },
  // PETSHOP_SEAL_KEY is a worker secret, set once (`wrangler secret put`); deploys keep it.
  // PETSHOP_BACKDOOR_SECRET stays unset, so the os-next e2e rows can call /__backdoor/* directly.
  "secrets": { "required": ["PETSHOP_SEAL_KEY"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "head_sampling_rate": 1, "persist": true, "invocation_logs": true },
    "traces": { "enabled": true, "persist": true, "head_sampling_rate": 1 },
  },
}

{
  // THE CONSOLE (src/console/**: React, DOM — the pages scripts/build.ts bundles into dist/client).
  // Kept out of the main tsconfig (workerd-typed, no DOM/JSX on purpose) and checked here instead.
  // The framework-free client half (the SDK's live-state.ts) stays in the worker's type world.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "node", "react", "react-dom"]
  },
  "include": ["src/console"],
  "exclude": []
}

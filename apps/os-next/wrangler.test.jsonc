{
  // wrangler.test.jsonc — config for the `workers` project of vitest.config.ts (the lane that runs
  // INSIDE workerd via @cloudflare/vitest-plugin; `pnpm test`). wrangler.jsonc stays the deploy
  // truth. The divergences, each deliberate and test-only:
  //
  //  1. the two generated modules the worker imports are written by scripts/build.ts
  //     (vitest.global-setup.ts) — the same way for every lane.
  //  2. no `ai` / `browser` binding (see the note by the bindings below); the in-process control plane's D1 +
  //     OAuth KV are fresh local namespaces with no schema — control-plane.test.ts applies
  //     control-plane.sql itself (the e2e lane does the same in its global-setup).
  //
  // KEPT identical on purpose: compatibility_date + flags, the declarative DO export, the LOADER
  // worker-loader binding, the DO binding, and the KV bindings (ids are meaningless locally —
  // miniflare keys namespaces by binding).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "os-next",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "allow_irrevocable_stub_storage",
    "global_fetch_strictly_public",
  ],
  "worker_loaders": [{ "binding": "LOADER" }],
  // The issuer's pages, the same files (issuer-bootstrap.test.ts fetches /authorize).
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // NO `ai` or `browser` binding here, on purpose: Workers AI and Browser Run are REMOTE-ONLY in
  // local dev, and vitest-pool-workers starts a remote proxy session for them at boot (an account to
  // pick, a network to reach). The workers lane never calls `itx.ai` / `itx.browser`; the e2e lane
  // boots from wrangler.jsonc (support/worker-config.ts) and carries the bindings, and its tests
  // shadow them locally / call them only against the deployed worker
  // (e2e/ai-root-shadow-and-fable.e2e.test.ts, e2e/browser-root.e2e.test.ts). `env.AI` and
  // `env.BROWSER` are undefined in this lane.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Email Sending, simulated: the sign-in code's mail goes nowhere (the tests hand the code
  // sign-in a fake mailbox when they need to read the code, and the test code otherwise).
  "send_email": [{ "name": "EMAIL" }],
  "durable_objects": {
    "bindings": [
      { "name": "ITERATE_CONTEXT", "class_name": "IterateContextDurableObject" },
      { "name": "BROWSER_SESSION", "class_name": "BrowserSession" },
      { "name": "SECRET", "class_name": "SecretDurableObject" },
    ],
  },
  "exports": {
    "IterateContextDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "BrowserSession": { "type": "durable-object", "storage": "sqlite" },
    "SecretDurableObject": { "type": "durable-object", "storage": "sqlite" },
    // THE FIRST-PARTY FACETS: Durable Object classes hosted as facets of a context through
    // `ctx.exports` — declared like any DO class (the facet's own SQLite is where their state lives).
    "AccountDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "AgentDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "OrganizationDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "ProjectDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "RepoDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "WorkspaceDurableObject": { "type": "durable-object", "storage": "sqlite" },
  },
  // The control plane is in-process: a local (empty) D1 + OAuth KV so the worker loads; the e2e lane
  // applies the schema (support/global-setup.ts). ids are meaningless locally.
  "d1_databases": [
    { "binding": "DB", "database_name": "control-plane-directory", "database_id": "test" },
  ],
  "kv_namespaces": [
    { "binding": "ITX_KV", "id": "08df862920b04446b3503c22f9888b04" },
    { "binding": "OAUTH_KV", "id": "oauth-test" },
  ],
  // Configuration (src/worker.ts `parseAppConfig`): the workers lane is its own deployment name; its
  // project hosts hang under `projects.test` (SELF.fetch takes any hostname — no DNS); the two
  // required secrets are test values (control-plane.test.ts and session-doors.test.ts sign in and
  // authenticate with them).
  "vars": {
    "APP_CONFIG_ENVIRONMENT_NAME": "test",
    "APP_CONFIG_PLATFORM_ORIGIN": "https://control.test",
    // the landing page's pointer (control-plane.test.ts)
    "APP_CONFIG_DASH_ORIGIN": "https://dash.test",
    "APP_CONFIG_GOOGLE_CLIENT_ID": "google-test-client",
    "APP_CONFIG_GOOGLE_CLIENT_SECRET": "google-test-secret",
    "APP_CONFIG_PROJECT_HOSTNAME_BASE": "projects.test",
    // one custom apex, for the consent test that binds a client on it to its project
    "APP_CONFIG_PROJECT_CUSTOM_HOSTNAMES": "custom-apex.test=custom-apex-project",
    "APP_CONFIG_SESSION_SECRET": "test-session-secret",
    "APP_CONFIG_SECRETS_KEY": "test-secrets-key",
    "APP_CONFIG_ADMIN_API_SECRET": "test-admin-api-secret",
    // the test code (424242) signs in through the page's real posts; the mailed code is tested with
    // a fake mailbox handed to login-code.ts directly
    "APP_CONFIG_TEST_EMAIL_LOGIN": "true",
    "APP_CONFIG_LOGIN_EMAIL_FROM": "iterate <login@control.test>",
  },
}

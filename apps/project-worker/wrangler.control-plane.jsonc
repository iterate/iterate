{
  // The control-plane shell — a SECOND worker the project worker falls back to (self-host / hosted topology).
  // Same repo, deployed separately: `wrangler deploy --config wrangler.control-plane.jsonc`.
  "name": "iterate-control-plane",
  "main": "src/control-plane-shell.ts",
  "compatibility_date": "2026-07-01",
  "account_id": "04b3b57291ef2626c6a8daa9d47065a7",
  "workers_dev": true,

  // First-party / platform secrets substituted at this outer shell (hosted). Omit for a self-host control
  // plane with no first-party keys.
  "kv_namespaces": [{ "binding": "PLATFORM_SECRETS_KV", "id": "34af8f4b5e49447f9b7bd63039a39ce3" }],
}

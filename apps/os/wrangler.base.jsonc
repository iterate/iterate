{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "os-next",
  // Vite builds the Worker from this entry. scripts/build.ts first prepares generated source the
  // Worker imports; vite.config.ts combines these bindings with one environment from envs.ts.
  "main": "src/worker.ts",
  // Start renders the landing and sign-in pages; consent and shared static files live in public/.
  // Worker-first routing keeps assets off project hosts and lets the Worker gate consent.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // nodejs_compat, spelled out: the DO's AsyncLocalStorage (node:async_hooks) needs it. Loaded
  // userspace isolates are the pure-play half — context/worker-loader.ts mints them with
  // no_nodejs_compat, so what runs inside a context stays portable across workerd builds.
  "compatibility_date": "2026-09-01",
  // allow_irrevocable_stub_storage (experimental, undocumented): lets loaded code STORE its env.ITX
  // stub in its own durable storage and replay it (e2e/workers-and-facets.e2e.test.ts pins it); every worker
  // in the chain needs it, so the loaded isolates carry it too (context/worker-loader.ts).
  // global_fetch_strictly_public: the OAuth provider's Client ID Metadata Documents (oauth.ts
  // `clientIdMetadataDocumentEnabled`) — its fetch of a client's metadata URL must reach the public
  // internet only, never same-zone routing; without the flag the provider advertises no CIMD.
  "compatibility_flags": [
    "nodejs_compat",
    "allow_irrevocable_stub_storage",
    "global_fetch_strictly_public",
  ],
  // No `account_id` here: the Vite config selects one — local is the dev/preview
  // account (envs.ts PREVIEW_AND_DEV_ACCOUNT_ID), each deployment's its own. The account matters
  // locally: wrangler's local runtime PROXIES the Artifacts, AI and Browser bindings to the real
  // products on that account, under the developer's `wrangler login`.
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } },
  "workers_dev": true,
  // subrequests: a capnweb WebSocket session is pumped by ONE long-lived stateless invocation, and
  // every edge->DO `invoke` it makes is a subrequest counted against that one invocation for the
  // session's whole life — the 10,000 paid default is hit by an ordinary long-lived client
  // (3 appends/s for ~1 h). cpu_ms: a cold re-reduce over a long log, or a large per-commit fan-out,
  // is CPU-bound on the DO's single thread; 5 min (the paid max) gives 10x the 30 s default before a
  // CPU-limit abort. Neither is billed until used.
  "limits": { "subrequests": 1000000, "cpu_ms": 300000 },

  // The Worker Loader that runs each project's confined config worker / agents.
  "worker_loaders": [{ "binding": "LOADER" }],
  // Workers AI, exposed VERBATIM as the built-in root `itx.ai` (context/built-ins.ts).
  "ai": { "binding": "AI" },
  // Browser Run, the built-in root `itx.browser` (context/built-ins.ts). Quick Actions need the
  // remote binding in local wrangler; the workers test lane omits this the same way it omits `ai`.
  "browser": { "binding": "BROWSER" },
  // Email Sending: the sign-in code's way out (src/password-and-code-sign-in.ts). wrangler dev simulates it (the
  // message lands in a local file); a deployment sends from APP_CONFIG_LOGIN_EMAIL_FROM (envs.ts).
  "send_email": [{ "name": "EMAIL" }],
  // R2, the built-in root `itx.r2` (`itx.files` on top). Local wrangler keeps it in .wrangler/state;
  // a deployment's bucket is `<resourceNamePrefix>-files` (envs.ts, ensure-resources).
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "os-next-files" }],
  // Cloudflare Artifacts ("git for agents", beta) — the ONE bound namespace, project-scoped as the
  // built-in root `itx.cfArtifacts` (context/built-ins.ts forces every repo name under `${projectId}.`).
  // A namespace is created by name through the API (`POST /accounts/<id>/artifacts/namespaces`; a
  // repo create on a missing one fails with "Namespace is not active"). wrangler's local runtime has
  // NO Artifacts simulator — the binding is a proxy to the real product on the block's account — so
  // the local lane (`pnpm dev`, `pnpm e2e`) has a namespace of its own on the dev/preview account,
  // created once by hand (2026-09-22); until then it named prd's, and every local run wrote real
  // repos there. A deployment's is envs.ts `artifactsNamespace`; a preview's is
  // `os-next-preview-<name>-repos`, created and deleted with the preview (scripts/preview.ts).
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "os-next-dev-repos" }],

  // Deploy identity. Loader isolates are cached ACROSS deployments, but a DO is durable and
  // survives redeploys — so a facet built from an isolate minted by a PRIOR deployment can't be
  // called from the new parent ("Durable Object Facet stubs cannot be transferred between Workers").
  // The loader cache key includes workerVersion(env)=CF_VERSION_METADATA.id to prevent exactly
  // this (see confinedWorker in context/worker-loader.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // THE context DO: one per {projectId, path}, codec-named — the stream, the routing table, and
  // every hibernatable socket in one addressable parent.
  "durable_objects": {
    "bindings": [
      { "name": "ITERATE_CONTEXT", "class_name": "IterateContextDurableObject" },
      { "name": "BROWSER_SESSION", "class_name": "BrowserSession" },
    ],
  },
  // The DOs' lifecycle, declaratively: SQLite-backed classes, no migration history to replay.
  "exports": {
    "IterateContextDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "BrowserSession": { "type": "durable-object", "storage": "sqlite" },
    // THE FIRST-PARTY FACETS: Durable Object classes hosted as facets of a context through
    // `ctx.exports` (iterate-context-durable-object.ts FIRST_PARTY_FACET_CLASSES) — declared like any
    // DO class (wrangler requires the storage line); their state lives in the facet's own SQLite.
    // `SecretDurableObject` was a bound namespace (`SECRET`) until 2026-09-21; the facet of the same
    // name took over, and the old objects are unreachable by name — set the secrets again.
    "AccountDurableObject": { "type": "durable-object", "storage": "sqlite" },
    // The removed built-in was hosted as a facet of IterateContextDurableObject. Retire its
    // unused standalone namespace; agent streams and facet storage belong to the context.
    "AgentDurableObject": { "type": "durable-object", "state": "deleted" },
    "OrganizationDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "ProjectDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "RepoDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "SecretDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "WorkspaceDurableObject": { "type": "durable-object", "storage": "sqlite" },
  },

  // The in-process control plane's directory (src/control-plane.sql: users, orgs,
  // org_members, projects — a project's id IS its slug).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "control-plane-directory",
      "database_id": "fb3502bf-da4c-42e7-8e70-6f75765f7a4d",
    },
  ],

  // OAUTH_KV = the in-process OAuth AS's provider store (grants/tokens/DCR clients).
  "kv_namespaces": [
    // itx.kv backing — project-prefixed (the D8 portability proof point).
    { "binding": "ITX_KV", "id": "08df862920b04446b3503c22f9888b04" },
    { "binding": "OAUTH_KV", "id": "b8efbdc3253840fa95331a80efbeb03d" },
  ],

  // The directory schema (src/control-plane.sql) is imported as text and applied at boot
  // (src/worker.ts) — idempotent, so every deployment, local or not, brings its own D1 up to date.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"] }],
  // CONFIGURATION (src/app-config.ts): ONE JSON object, the `APP_CONFIG` Worker secret —
  // `{ urls, login, secrets }` — plus `APP_CONFIG_SECRETS__KEY` standing alone so it can rotate with
  // `previousKey` beside it. Any key can be set alone as `APP_CONFIG_<PATH>__<KEY>`; the generator
  // computes a deployment's `urls` that way from envs.ts (scripts/generate-wrangler-config.ts), so the
  // vars below are only the local-dev defaults. (No wrangler `secrets.required` here: it is a types
  // and local-dev aid, not a deploy guard, and it collides with a harness that passes the same names
  // as vars — the e2e lane's.)
  "vars": {
    "APP_CONFIG_URLS__OS": "http://localhost:8788",
    "APP_CONFIG_URLS__INGRESS_ROUTING": "{\"type\":\"subdomains\",\"hostname\":\"localhost\"}",
  },
}

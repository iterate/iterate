{
  "name": "os",
  "private": true,
  "type": "module",
  "description": "OS: the Iterate platform Worker and its TanStack Start issuer pages",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts && vite build",
    "deploy": "tsx scripts/deploy.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "pnpm build && vitest run --configLoader runner --project unit --project workers --reporter=default --reporter=../../packages/shared/src/test-support/e2e-policy/retry-telemetry-reporter.ts",
    "test:watch": "vitest --configLoader runner --project unit",
    "e2e": "pnpm build && pnpm e2e:run",
    "e2e:run": "vitest run --configLoader runner --project e2e --sequence.concurrent --reporter=default --reporter=../../packages/shared/src/test-support/e2e-policy/retry-telemetry-reporter.ts",
    "e2e:soak": "tsx scripts/e2e-soak.ts",
    "perf": "pnpm build && pnpm perf:run",
    "perf:run": "vitest run --configLoader runner --project perf",
    "bench": "pnpm build && vitest bench --configLoader runner --run --project bench",
    "preview": "tsx scripts/preview.ts",
    "ensure-resources": "tsx scripts/ensure-resources.ts",
    "erase-data": "tsx scripts/erase-data.ts",
    "control-plane-load": "tsx scripts/control-plane-load.ts",
    "project-seed": "tsx scripts/project-seed.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.0.0",
    "@iterate-com/shared": "workspace:*",
    "@iterate-com/ui": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "@tanstack/react-router": "1.168.3",
    "@tanstack/react-start": "1.167.5",
    "capnweb": "npm:@iterate-com/capnweb@^0.12.2",
    "iterate": "workspace:*",
    "json5": "^2.2.3",
    "oauth4webapi": "^3.8.5",
    "posthog-js": "1.404.0",
    "posthog-node": "^5.52.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:cloudflare",
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "catalog:cloudflare",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.27.4",
    "trpc-cli": "0.15.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "undici": "^7.29.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.7",
    "wrangler": "catalog:cloudflare"
  }
}

{
  "name": "os",
  "private": true,
  "type": "module",
  "description": "OS: the Iterate platform Worker and its TanStack Start issuer pages",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts && vite build",
    "deploy": "tsx scripts/deploy.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "pnpm build && vitest run --configLoader runner --project unit --project workers",
    "test:watch": "vitest --configLoader runner --project unit",
    "e2e": "pnpm build && pnpm e2e:run",
    "e2e:run": "vitest run --configLoader runner --project e2e --sequence.concurrent",
    "e2e:soak": "tsx scripts/e2e-soak.ts",
    "perf": "pnpm build && pnpm perf:run",
    "perf:run": "vitest run --configLoader runner --project perf",
    "bench": "pnpm build && vitest bench --configLoader runner --run --project bench",
    "preview": "tsx scripts/preview.ts",
    "ensure-resources": "tsx scripts/ensure-resources.ts",
    "erase-data": "tsx scripts/erase-data.ts",
    "control-plane-load": "tsx scripts/control-plane-load.ts",
    "project-seed": "tsx scripts/project-seed.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.0.0",
    "@iterate-com/shared": "workspace:*",
    "@iterate-com/ui": "workspace:*",
    "@modelcontextprotocol/server": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "capnweb": "catalog:",
    "cn": "catalog:",
    "iterate": "workspace:*",
    "json5": "catalog:",
    "oauth4webapi": "catalog:",
    "posthog-node": "^5.53.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "^1.2.4",
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "esbuild": "catalog:",
    "trpc-cli": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "undici": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "ws": "catalog:"
  }
}

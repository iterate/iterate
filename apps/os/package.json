{
  "name": "os",
  "private": true,
  "type": "module",
  "description": "OS: the Iterate platform Worker and its TanStack Start issuer pages",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "getin": "node scripts/getin.ts",
    "build": "node scripts/build.ts && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "pnpm build && vitest run --configLoader runner --project unit --project workers --silent=passed-only",
    "test:watch": "vitest --configLoader runner --project unit",
    "db:generate": "sqlfu generate",
    "db:check": "rm -f .sqlfu/app.db && sqlfu migrate --yes && sqlfu check",
    "db:draft": "sqlfu draft",
    "db:migrate": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state -c wrangler.base.jsonc"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.0.0",
    "@iterate-com/shared": "workspace:*",
    "@iterate-com/ui": "workspace:*",
    "@modelcontextprotocol/server": "catalog:",
    "@octokit/auth-app": "8.3.1",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-start": "catalog:",
    "capnweb": "catalog:",
    "cn": "catalog:",
    "es-module-lexer": "^2.1.0",
    "iterate": "workspace:*",
    "json5": "catalog:",
    "oauth4webapi": "catalog:",
    "pako": "catalog:",
    "postal-mime": "4.0.0",
    "posthog-node": "^5.53.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sqlfu": "0.1.1",
    "sucrase": "^3.35.1",
    "tailwindcss": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "^1.3.2",
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/ws": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "esbuild": "catalog:",
    "trpc-cli": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "ws": "catalog:"
  }
}

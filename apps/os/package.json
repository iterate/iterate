{
  "name": "@iterate-com/os",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "~/*": "./src/*"
  },
  "scripts": {
    "cli": "tsx ./scripts/cli.ts",
    "dev": "tsx ./scripts/dev.ts",
    "dev:local": "tsx ./scripts/dev.ts --skip-doppler",
    "build": "doppler run -- pnpm exec vite build",
    "probe:do-duration": "tsx ./scripts/do-duration-probe.ts",
    "deploy": "tsx ./scripts/deploy.ts",
    "destroy": "tsx ./scripts/erase-data.ts",
    "ensure-resources": "tsx ./scripts/ensure-resources.ts",
    "erase-data": "tsx ./scripts/erase-data.ts",
    "gen:wrangler": "tsx ./scripts/generate-wrangler-config.ts",
    "routes:generate": "tsx ./scripts/generate-route-tree.ts",
    "generate:itx-api": "tsx ./scripts/generate-itx-api.ts",
    "generate:itx-examples": "tsx ./scripts/generate-itx-examples.ts",
    "routes:check": "tsx ./scripts/generate-route-tree.ts --check",
    "typecheck": "pnpm routes:check && pnpm gen:wrangler && tsc --noEmit && pnpm typecheck:template",
    "typecheck:template": "tsx ./scripts/typecheck-config-repo-template.ts",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --reporter=default --reporter=../../packages/shared/src/test-support/e2e-policy/retry-telemetry-reporter.ts",
    "e2e": "vitest --config e2e/vitest.config.ts",
    "example:workspace-itx-preview": "tsx ./e2e/workspace-itx-preview-example.ts",
    "auth:sync-clients": "tsx ./scripts/sync-auth-clients.ts",
    "test:watch": "vitest"
  },

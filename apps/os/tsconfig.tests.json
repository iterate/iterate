{
  // Typecheck for the TEST TREES the base config's `include: ["src"]` never sees: the vitest E2E
  // suite (e2e/**), its budgets (perf/**) and its benchmarks (bench/**), the loaded-code example (examples/**), the workers
  // suite (__workers-tests__/**) and the scripts that import worker code (inspect-context,
  // project-seed*; tsconfig.scripts.json has the other node scripts). Keeps workers-types (the tests import src, which needs them) and adds node
  // types (the tests run in Node). `pnpm typecheck` runs all three configs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node", "vite/client", "@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "e2e",
    "perf",
    "bench",
    "examples",
    "../agents/e2e",
    "../agents/__workers-tests__",
    "__workers-tests__",
    "scripts/inspect-context.ts",
    "scripts/project-seed*.ts"
  ],
  "exclude": []
}

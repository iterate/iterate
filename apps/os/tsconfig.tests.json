{
  // Typecheck for the TEST TREES the base config's `include: ["src"]` never sees: the loaded-code
  // example (examples/**), the workers suite (__workers-tests__/**) and the modules it shares with
  // test/ (test-support/**), and the scripts that import worker code (project-seed-format.ts;
  // tsconfig.scripts.json has the other node scripts). Keeps workers-types (the tests import src, which needs them) and adds node
  // types (the tests run in Node). `pnpm typecheck` runs all three configs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node", "vite/client", "@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "examples",
    "test-support",
    "../agents/__workers-tests__",
    "__workers-tests__",
    "scripts/project-seed*.ts"
  ],
  "exclude": []
}

# scripts/build.ts: the two generated modules (their .d.ts siblings are committed). Only the
# declarations belong in git — a stale generated .ts here shadows them for tsc.
/src/generated/*
!/src/generated/*.d.ts

# Generated wrangler configs: only the hand-kept template (base) and the test config belong in git.
# Every other variant (preview, self-host, worker-bundler, typechecker, the plain jsonc from an older
# checkout) is written by scripts/build.ts / generate-wrangler-config.ts and must never be committed.
/wrangler.jsonc
/wrangler.*.jsonc
!/wrangler.base.jsonc
!/wrangler.test.jsonc
/output/

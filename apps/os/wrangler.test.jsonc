{
  // wrangler.test.jsonc — config for the `workers` project of vitest.config.ts (the suite that runs
  // INSIDE workerd via @cloudflare/vitest-plugin; `pnpm test`). Vite's built entry is the code
  // under test. The divergences, each deliberate and test-only:
  //
  //  1. the two generated modules the worker imports are written by scripts/build.ts
  //     (vitest.global-setup.ts) — the same way for every suite.
  //  2. no `ai` / `browser` binding (see the note by the bindings below); the in-process control
  //     plane's OAuth KV is a fresh local namespace.
  //
  // KEPT identical on purpose: compatibility_date + flags, the declarative DO export, the LOADER
  // worker-loader binding, the DO binding, and the KV bindings (ids are meaningless locally —
  // miniflare keys namespaces by binding).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "os",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "allow_irrevocable_stub_storage",
    "global_fetch_strictly_public",
  ],
  "worker_loaders": [{ "binding": "LOADER" }],
  // The issuer's pages, the same files (issuer-bootstrap.test.ts fetches /oauth2/auth).
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // NO `ai` or `browser` binding here, on purpose: Workers AI and Browser Run are REMOTE-ONLY in
  // local dev, and vitest-pool-workers starts a remote proxy session for them at boot (an account to
  // pick, a network to reach). The Workers suite never calls `itx.ai` / `itx.browser`; the e2e suite
  // boots from the Vite-built Wrangler config (support/worker-config.ts) and carries the bindings, and its tests
  // shadow them locally / call them only against the deployed worker
  // (e2e/ai-root-shadow-and-fable.e2e.test.ts, e2e/browser-root.e2e.test.ts). `env.AI` and
  // `env.BROWSER` are undefined in this suite.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Email Sending, simulated: the sign-in code's mail goes nowhere (the tests hand the code
  // sign-in a fake mailbox when they need to read the code, and the test code otherwise).
  "send_email": [{ "name": "EMAIL" }],
  "durable_objects": {
    "bindings": [
      { "name": "ITERATE_CONTEXT", "class_name": "IterateContextDurableObject" },
      { "name": "BROWSER_SESSION", "class_name": "BrowserSession" },
      { "name": "CONTROL_PLANE", "class_name": "ControlPlaneDurableObject" },
    ],
  },
  "exports": {
    "IterateContextDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "BrowserSession": { "type": "durable-object", "storage": "sqlite" },
    // THE FIRST-PARTY FACETS: Durable Object classes hosted as facets of a context through
    // `ctx.exports` — declared like any DO class (the facet's own SQLite is where their state lives).
    "AccountDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "ControlPlaneDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "OrganizationDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "ProjectDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "RepoDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "SecretDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "WorkspaceDurableObject": { "type": "durable-object", "storage": "sqlite" },
  },
  // The control plane is in-process: a local OAuth KV so the worker loads. ids are meaningless locally.
  "kv_namespaces": [
    { "binding": "ITX_KV", "id": "08df862920b04446b3503c22f9888b04" },
    { "binding": "OAUTH_KV", "id": "oauth-test" },
  ],
  // Configuration (src/app-config.ts): the `APP_CONFIG_<PATH>__<KEY>` spellings of the one object —
  // this suite's issuer is `control.test`, its project hosts hang under `projects.test` (`exports.default.fetch`
  // takes any hostname — no DNS), and its secrets are test values (control-plane.test.ts and
  // project-host-routing.test.ts sign in with the password and authenticate with the admin bearer).
  "vars": {
    "APP_CONFIG_URLS__OS": "https://control.test",
    // the landing page's pointer (control-plane.test.ts)
    "APP_CONFIG_URLS__DASH": "https://dash.test",
    "APP_CONFIG_URLS__INGRESS_ROUTING": "{\"type\":\"subdomains\",\"hostname\":\"projects.test\"}",
    // projects' own hostnames, on a SaaS zone whose Cloudflare API the tests fake
    // (project-host-routing.test.ts); the consent test claims one directly (issuer-bootstrap.test.ts)
    "APP_CONFIG_CUSTOM_HOSTNAMES": "{\"zone\":\"saas.test\",\"zoneId\":\"zone-saas\",\"dcvDelegationUuid\":\"dcv-uuid\",\"reservedZones\":[\"control.test\",\"dash.test\",\"projects.test\",\"saas.test\"]}",
    "APP_CONFIG_CLOUDFLARE_API_TOKEN": "cloudflare-test-token",
    // the password signs in through the page's real posts; the mailed code is tested with a fake
    // mailbox handed to password-and-code-sign-in.ts directly
    "APP_CONFIG_LOGIN__PASSWORD": "test-password",
    "APP_CONFIG_LOGIN__EMAIL_CODE__FROM": "iterate <login@control.test>",
    "APP_CONFIG_LOGIN__GOOGLE__CLIENT_ID": "google-test-client",
    "APP_CONFIG_LOGIN__GOOGLE__CLIENT_SECRET": "google-test-secret",
    "APP_CONFIG_LOGIN__CLOUDFLARE__CLIENT_ID": "cloudflare-test-client",
    "APP_CONFIG_LOGIN__CLOUDFLARE__CLIENT_SECRET": "cloudflare-test-secret",
    "APP_CONFIG_SECRETS__KEY": "test-secrets-key",
    "APP_CONFIG_SECRETS__ADMIN_BEARER": "test-admin-api-secret",
  },
}

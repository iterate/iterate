{
  // wrangler.test.jsonc — what the Workers suite (the `workers` project of vitest.config.ts, run
  // INSIDE workerd via @cloudflare/vitest-plugin) sets over wrangler.base.jsonc, key by key:
  // vitest.config.ts `workersWranglerConfigPath` builds the suite's config from the base, without
  // its remote-only bindings, and these keys over it. Everything else is the base's.
  "$schema": "node_modules/wrangler/config-schema.json",
  // Configuration (src/app-config.ts): the `APP_CONFIG_<PATH>__<KEY>` spellings of the one object —
  // this suite's issuer is `control.test`, its project hosts hang under `projects.test` (`exports.default.fetch`
  // takes any hostname — no DNS), and its secrets are test values (control-plane.test.ts and
  // project-host-routing.test.ts sign in with the password and authenticate with the admin bearer).
  "vars": {
    // the Worker's own name, which every config names (scripts/generate-wrangler-config.ts)
    "WORKER_NAME": "os",
    "APP_CONFIG_URLS__OS": "https://control.test",
    // the landing page's pointer (control-plane.test.ts)
    "APP_CONFIG_URLS__DASH": "https://dash.test",
    "APP_CONFIG_URLS__INGRESS_ROUTING": "{\"type\":\"subdomains\",\"hostname\":\"projects.test\"}",
    // __workers-tests__/email.test.ts: wildcard.test's mail is project wildcard-mail's
    "APP_CONFIG_URLS__PROJECT_WILDCARD": "{\"hostname\":\"wildcard.test\",\"project\":\"wildcard-mail\",\"forwardEmailTo\":\"everything@example.test\"}",
    // projects' own hostnames, on a SaaS zone whose Cloudflare API the tests fake
    // (project-host-routing.test.ts); the consent test claims one directly (issuer-bootstrap.test.ts)
    "APP_CONFIG_CUSTOM_HOSTNAMES": "{\"zone\":\"saas.test\",\"zoneId\":\"zone-saas\",\"dcvDelegationUuid\":\"dcv-uuid\",\"reservedZones\":[\"control.test\",\"dash.test\",\"projects.test\",\"saas.test\"]}",
    "APP_CONFIG_CLOUDFLARE_API_TOKEN": "cloudflare-test-token",
    // the password signs in through the page's real posts; the mailed code is tested with a fake
    // mailbox handed to password-and-code-sign-in.ts directly
    "APP_CONFIG_LOGIN__PASSWORD": "test-password",
    "APP_CONFIG_LOGIN__EMAIL_CODE__FROM": "iterate <login@control.test>",
    // Sign in with Google, Cloudflare and GitHub through the pet shop's fakes, iterate's clients
    // below (__workers-tests__/identity.test.ts); a fake admits addresses under the test email domain
    "APP_CONFIG_LOGIN__GOOGLE": "{}",
    "APP_CONFIG_LOGIN__CLOUDFLARE": "{\"scopes\":[\"openid\",\"user-details.read\",\"offline_access\"]}",
    "APP_CONFIG_LOGIN__GITHUB": "{}",
    "APP_CONFIG_LOGIN__TEST_EMAIL_DOMAIN": "signin.test",
    // the platform admin (admin-and-impersonation.test.ts)
    "APP_CONFIG_ADMINS": "[\"oauth-admin@example.com\"]",
    "APP_CONFIG_SECRETS__KEY": "test-secrets-key",
    "APP_CONFIG_SECRETS__ADMIN_BEARER": "test-admin-api-secret",
    // iterate's Slack app and Google and Cloudflare clients, answered by the pet shop's fakes at
    // slack.test, google.test and cloudflare.test (__workers-tests__/integrations.test.ts); its GitHub App is vitest.config.ts's
    "APP_CONFIG_INTEGRATIONS__SLACK": "{\"oauthClientId\":\"petshop-default\",\"oauthClientSecret\":\"petshop-default-secret\",\"webhookSigningSecret\":\"slack-test-signing-secret\",\"slackOrigin\":\"https://slack.test\"}",
    "APP_CONFIG_INTEGRATIONS__X": "{\"oauthClientId\":\"petshop-default\",\"oauthClientSecret\":\"petshop-default-secret\",\"xOrigin\":\"https://x.test\"}",
    "APP_CONFIG_INTEGRATIONS__GOOGLE": "{\"oauthClientId\":\"petshop-default\",\"oauthClientSecret\":\"petshop-default-secret\",\"googleOrigin\":\"https://google.test\"}",
    "APP_CONFIG_INTEGRATIONS__CLOUDFLARE": "{\"oauthClientId\":\"petshop-default\",\"oauthClientSecret\":\"petshop-default-secret\",\"cloudflareOrigin\":\"https://cloudflare.test\"}",
  },
}

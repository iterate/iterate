{
  // The node programs and their tests: every scripts/*.ts but the few that import worker code and
  // need its types (tsconfig.tests.json owns those).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": { "types": ["node"] },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.global-setup.ts",
    "sqlfu.config.ts",
    "scripts/*.ts"
  ],
  "exclude": ["scripts/project-seed-format.ts"]
}

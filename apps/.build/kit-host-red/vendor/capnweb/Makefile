	cd /Users/jonastemplestein/.herdr/worktrees/iterate/c-capabilities/apps/.build/kit-host-red && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0

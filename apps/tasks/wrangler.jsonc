// Checked in (unlike the fleet apps' generated configs): this app deploys
// manually to tasks.iterate.workers.dev (`pnpm run deploy` with
// CLOUDFLARE_ACCOUNT_ID set) and is not wired into envs.ts / the deploy
// fleet. No routes: per-project access goes through each project's config
// worker proxy (tasks--<slug>.iterate.app), never a domain on this worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tasks",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-06-17",
  "compatibility_flags": ["nodejs_compat"],
  "exports": {
    // Tombstones: the Yjs checkout DO and its index, retired by the
    // workspace-lens consolidation — boards live on platform workspaces and
    // the sidebar lists them from the platform's stream catalog. Both DOs
    // were disposable by contract (committed state lives in git; the index
    // was a convenience surface). Remove the tombstones once a deploy
    // reports the namespaces reconciled (as TasksBoardDurableObject was).
    "TasksCheckoutDurableObject": {
      "type": "durable-object",
      "state": "deleted",
    },
    "TasksCheckoutIndexDurableObject": {
      "type": "durable-object",
      "state": "deleted",
    },
  },
  "vars": {
    "OS_BASE_URL": "https://os.iterate.com",
  },
}

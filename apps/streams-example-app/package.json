{
  "name": "@iterate-com/streams-example-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "tsx ./scripts/deploy.ts",
    "destroy": "tsx ./scripts/erase-data.ts",
    "erase-data": "tsx ./scripts/erase-data.ts",
    "gen:wrangler": "tsx ./scripts/generate-wrangler-config.ts",
    "test": "vitest run --config vitest.unit.config.ts",
    "vitest": "vitest run e2e/vitest",
    "playwright": "playwright test e2e/playwright",
    "test:e2e": "pnpm vitest && pnpm playwright",
    "typecheck": "pnpm gen:wrangler && tsc --noEmit"
  },
  "dependencies": {
    "@iterate-com/auth": "workspace:*",
    "@iterate-com/shared": "workspace:*",
    "@journeyapps/wa-sqlite": "^1.7.0",
    "@tanstack/react-router": "^1.170.10",
    "@tanstack/react-start": "^1.168.18",
    "@tanstack/react-virtual": "^3.14.5",
    "capnweb": "npm:@iterate-com/capnweb@^0.10.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:cloudflare",
    "@cloudflare/workers-types": "catalog:cloudflare",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "iterate": "workspace:*",
    "tailwindcss": "^4.3.2",
    "trpc-cli": "0.15.1",
    "tsx": "^4.20.6",
    "undici": "^7.16.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.7",
    "wrangler": "catalog:cloudflare"
  }
}

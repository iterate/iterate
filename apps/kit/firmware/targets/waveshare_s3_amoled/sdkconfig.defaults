CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# LVGL: fonts the Iterate UI uses, plus RGB565 to match the panel.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_PERF_MONITOR=n

# LVGL's own pool is internal RAM the Wi-Fi driver needs; this UI is a handful
# of labels and one button, so 24 KiB is ample.
CONFIG_LV_MEM_SIZE_KILOBYTES=24

# Screenshots: the takeScreenshot capability renders the active screen into a
# PSRAM draw buffer of our own (LVGL's pool is far too small for a frame).
CONFIG_LV_USE_SNAPSHOT=y

# The BSP's default 100-line LVGL buffer (73 KiB) is allocated with
# MALLOC_CAP_DEFAULT, so it can land in PSRAM — and then every flush needs an
# equally large internal bounce buffer for SPI DMA, which this build cannot
# afford next to Wi-Fi ("spi transmit (queue) color failed"). 24 lines makes
# the bounce cheap either way.
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=24

# The app task is the SOLE consumer of the control inbox and therefore the
# speaker's producer: it decodes base64 PCM and pushes it to the playback
# buffer within a 20ms budget. At the default priority 1 on core 0 it sat
# behind Wi-Fi (23), lwIP (18), the event loop (20), the WebSocket task (5)
# and LVGL (4) — so the downlink was serviced only when nothing else wanted
# the CPU, which is precisely when inbound audio peaks. Priority 6 on core 1
# puts it on the audio core, above LVGL and the recorder, below the two
# dedicated audio tasks.
CONFIG_ESP_MAIN_TASK_PRIORITY=6
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y

# The I2S EOF ISR must not be deferred by a flash/cache stall; the M5StickS3
# sets this for the same reason.
CONFIG_I2S_ISR_IRAM_SAFE=y

# 1ms ticks: pdMS_TO_TICKS(5) rounds to 0 at 100Hz, so the app loop's delay
# silently became a 10ms tick and halved the inbox drain rate.
CONFIG_FREERTOS_HZ=1000

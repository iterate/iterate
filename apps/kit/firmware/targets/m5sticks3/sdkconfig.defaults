CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../common/partitions-8mb.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_LOG_DEFAULT_LEVEL=3

# Required by the atomics the audio fence and telemetry use once .bss rides
# PSRAM; the donor's realtime ELF audit enforced it, and it arrived only
# implicitly from the SPIRAM config there. Explicit here.
CONFIG_STDATOMIC_S32C1I_SPIRAM_WORKAROUND=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# Keep internal DMA memory available for Wi-Fi and the SPI drivers.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304

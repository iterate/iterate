{
  "name": "@iterate-com/kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A tiny browser-based installer for Iterate voice devices.",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm firmware:sync && vite build && tsc --noEmit",
    "device:e2e": "tsx ./scripts/device-e2e.ts",
    "voice:e2e": "tsx ./scripts/voice-e2e.ts",
    "preview": "vite preview",
    "deploy": "tsx ./scripts/deploy.ts",
    "ensure-resources": "tsx ./scripts/ensure-resources.ts",
    "firmware:flash": "tsx ./scripts/flash.ts",
    "firmware:sync": "tsx ./scripts/sync-firmware-assets.ts",
    "firmware:test:capnweb": "tsx ./scripts/test-capnweb-c-interop.ts",
    "firmware:test:diagnostics": "tsx ./scripts/test-runtime-diagnostics.ts",
    "firmware:test:websocket": "tsx ./scripts/test-firmware-websocket.ts",
    "firmware:test:websocket:control": "tsx ./scripts/test-firmware-websocket.ts --prove-stock-fails",
    "gen:wrangler": "tsx ./scripts/generate-wrangler-config.ts",
    "test": "vitest run --config vitest.config.ts --reporter=default --reporter=../../packages/shared/src/test-support/e2e-policy/retry-telemetry-reporter.ts",
    "typecheck": "pnpm gen:wrangler && tsc --noEmit"
  },
  "dependencies": {
    "@iterate-com/capnweb": "^0.10.0",
    "@iterate-com/ui": "workspace:*",
    "@tanstack/react-router": "^1.170.10",
    "@tanstack/react-start": "^1.168.18",
    "captun": "https://github.com/iterate/captun/releases/download/v0.0.3-websocket.6aa1207/captun-0.0.3.tgz",
    "esptool-js": "^0.6.0",
    "lucide-react": "^0.553.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:cloudflare",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.2",
    "trpc-cli": "0.15.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.7",
    "wrangler": "catalog:cloudflare",
    "ws": "8.19.0"
  }
}

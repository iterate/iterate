{
  "name": "@iterate-com/kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A tiny browser-based installer for Iterate voice devices.",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm firmware:sync && vite build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "tsx ./scripts/deploy.ts",
    "ensure-resources": "tsx ./scripts/ensure-resources.ts",
    "firmware:sync": "tsx ./scripts/sync-firmware-assets.ts",
    "gen:wrangler": "tsx ./scripts/generate-wrangler-config.ts",
    "test": "vitest run --config vitest.config.ts --reporter=default --reporter=../../packages/shared/src/test-support/e2e-policy/retry-telemetry-reporter.ts && pnpm firmware:test:host",
    "firmware:configure": "cmake -S firmware -B firmware/.build/host -DCMAKE_BUILD_TYPE=Debug -DITERATE_KIT_SANITIZE=ON",
    "firmware:build:host": "pnpm firmware:configure && cmake --build firmware/.build/host --parallel",
    "firmware:test:host": "pnpm firmware:build:host && ctest --test-dir firmware/.build/host --output-on-failure",
    "typecheck": "pnpm gen:wrangler && tsc --noEmit",
    "voice": "tsx ./clients/voice-cli.ts"
  },
  "dependencies": {
    "@iterate-com/ui": "workspace:*",
    "@tanstack/react-router": "^1.170.10",
    "@tanstack/react-start": "^1.168.18",
    "esp-web-tools": "^10.4.0",
    "lucide-react": "^0.553.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "4.3.6",
    "iterate": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:cloudflare",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.2",
    "trpc-cli": "0.15.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.7",
    "wrangler": "catalog:cloudflare",
    "@cloudflare/workers-types": "catalog:cloudflare"
  }
}

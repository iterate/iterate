{
  "name": "@iterate-com/kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A tiny browser-based installer for Iterate voice devices.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "pnpm routes:check && tsc --noEmit",
    "deploy": "tsx scripts/app.ts deploy",
    "ensure-resources": "tsx scripts/app.ts ensure-resources",
    "routes:generate": "tsx scripts/app.ts generate-route-tree",
    "routes:check": "tsx scripts/app.ts generate-route-tree --check",
    "test": "vitest run --config vitest.config.ts --reporter=default --reporter=../../packages/shared/src/test-support/e2e-policy/retry-telemetry-reporter.ts",
    "firmware:configure": "python3 firmware/tools/generate-atlases.py && cmake -S firmware -B firmware/.build/host -DCMAKE_BUILD_TYPE=Debug -DITERATE_KIT_SANITIZE=ON",
    "firmware:build:host": "pnpm firmware:configure && cmake --build firmware/.build/host --parallel",
    "firmware:test:host": "pnpm firmware:build:host && ctest --test-dir firmware/.build/host --output-on-failure",
    "firmware:build": "node ./scripts/firmware-release.ts build"
  },
  "dependencies": {
    "@iterate-com/shared": "workspace:*",
    "@iterate-com/ui": "workspace:*",
    "@tanstack/react-router": "1.168.3",
    "@tanstack/react-start": "1.167.5",
    "esp-web-tools": "^10.4.0",
    "iterate": "workspace:*",
    "lucide-react": "^0.553.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:cloudflare",
    "@cloudflare/workers-types": "catalog:cloudflare",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.7",
    "wrangler": "catalog:cloudflare",
    "esbuild": "^0.27.4"
  }
}

{
  "name": "kernel",
  "main": "src/kernel.ts",
  "compatibility_date": "2026-07-01",
  // iterate (prd) account — hosts iterate2.* (the staging mirror of iterate.com/iterate.app).
  "account_id": "04b3b57291ef2626c6a8daa9d47065a7",
  "workers_dev": true,
  // Pure-play: NO nodejs_compat (workerd/miniflare/Raspberry-Pi portability).
  "worker_loaders": [{ "binding": "LOADER" }],

  // The durable log (stream-do.ts) — the first real runtime capability. Top-level so every env inherits
  // it; SQLite-backed. One instance per (projectId, path).
  "durable_objects": { "bindings": [{ "name": "STREAM_DO", "class_name": "StreamDurableObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StreamDurableObject"] }],

  // ============================================================================================
  // The kernel is the SAME code in every deployment; only APP_CONFIG differs. Two independent knobs:
  //   • wall      — identity. OMIT it => WIDE OPEN (users don't exist; put your own Caddy/tunnel in
  //                 front, or nothing). Set it => a wall on ingress injected a JWT the kernel verifies.
  //                 Cloudflare Access and an auth.iterate.com proxy are the SAME {header,jwksUrl,issuer,
  //                 audience} shape — see wall.ts.
  //   • directory — which projects exist + membership: auth.iterate.com (real) | kv (local) | open.
  // Three example profiles: HOSTED (below) · SELF-HOST behind Access (env.selfhost) · SELF-HOST wide
  // open (env.dev). Same worker; three JSON strings.
  // ============================================================================================
  //
  // ---- Default = HOSTED (iterate2): Cloudflare Access WALL (IdP = auth.iterate.com) + auth-prd
  // directory. Access fronts `dashboard--*.templestein.iterate2.app`, authenticates the human via
  // auth.iterate.com (instant-auth → they see auth's own login, never a CF page), and injects a signed
  // Cf-Access-Jwt-Assertion the kernel verifies against the team's Access certs. IDENTICAL wall shape to
  // self-host below (same team org) — only the `audience` (this app's AUD) and the `directory` differ.
  // The public `<slug>` site is NOT fronted by Access, so it gets no header => anonymous (first-class). ----
  "vars": {
    "APP_CONFIG": "{\"hostBase\":\"templestein.iterate2.app\",\"wall\":{\"header\":\"cf-access-jwt-assertion\",\"jwksUrl\":\"https://iterate-com.cloudflareaccess.com/cdn-cgi/access/certs\",\"issuer\":\"https://iterate-com.cloudflareaccess.com\",\"audience\":\"1086cc92e4eb58d70bb3af47c5a398c812822c1f9a29c0c8191599c4db096db0\"},\"directory\":{\"provider\":\"auth.iterate.com\"}}",
    "OS_DASHBOARD_ORIGIN": "https://kernel-mini-os.iterate.workers.dev",
    // DEMO signing secret for project-app-session tokens (review #3). A real deployment supplies this
    // as a Doppler-backed secret, NOT a committed var — fine for this throwaway POC account.
    "PROJECT_APP_SESSION_SECRET": "872df450ac06f2761a5c629349804d7648dfc9e840c7d0b8ed58d657e9c44c73",
  },
  // The directory authority binds the REAL auth worker (same account, prd). Possession of this
  // binding is the credential (no token). Reads only (getProjectBySlug/listProjectsForUser); the
  // kernel never mutates the production directory. Default export = auth's AuthWorker RPC class.
  "services": [{ "binding": "AUTH", "service": "auth-prd" }],
  "routes": [{ "pattern": "*.templestein.iterate2.app/*", "zone_name": "iterate2.app" }],

  "env": {
    // ---- SELF-HOST behind Access (shiterate.com): Cloudflare Access WALL + kv directory ----
    // Same wall shape as HOSTED above (a self-hoster brings their OWN Access org + IdP — here it happens
    // to reuse the iterate-com org). Directory = kv: a LOCAL persistent registry in a KV namespace, NO
    // auth.iterate.com at all. So vs hosted, only the `audience` and `directory` differ — same worker. ----
    "selfhost": {
      "name": "kernel-selfhost",
      "worker_loaders": [{ "binding": "LOADER" }],
      "durable_objects": {
        "bindings": [{ "name": "STREAM_DO", "class_name": "StreamDurableObject" }],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StreamDurableObject"] }],
      // Workers AI (this account's) — the `local` source for the `ai` capability (self-host default: your
      // own account's AI). Flip APP_CONFIG.ai to {source:remote,...} for metered first-party AI.
      "ai": { "binding": "AI" },
      "kv_namespaces": [
        { "binding": "DIRECTORY_KV", "id": "402ac6e2e34f45d38d171abb630d434d" },
        // The ingress routing table (ADR 0020/0025). Same namespace, `route:` keys (vs `project:`).
        { "binding": "ROUTING_KV", "id": "402ac6e2e34f45d38d171abb630d434d" },
        // Per-project secrets + platform meters (egress.ts). Same namespace, `secret:`/`meter:` keys.
        { "binding": "SECRETS_KV", "id": "402ac6e2e34f45d38d171abb630d434d" },
      ],
      "vars": {
        // platformSecrets = the ITERATE-PRODUCT layer (ADR 0030): a demo first-party `echo` key iterate
        // holds, origin-pinned to httpbin (the live egress-proof target), substituted at the CP door.
        // ai.source=local => the project worker's own Workers AI (self-host default).
        "APP_CONFIG": "{\"hostBase\":\"shiterate.com\",\"wall\":{\"header\":\"cf-access-jwt-assertion\",\"jwksUrl\":\"https://iterate-com.cloudflareaccess.com/cdn-cgi/access/certs\",\"issuer\":\"https://iterate-com.cloudflareaccess.com\",\"audience\":\"f87852346c14aa744c6f25ae8ebc6e8c92fbffb11dd710b12c950c9ee1984b28\"},\"directory\":{\"provider\":\"kv\"},\"platformSecrets\":[{\"name\":\"echo\",\"value\":\"PLATFORM-KEY-abc123\",\"allowedOrigins\":[\"https://httpbin.org\"]}],\"ai\":{\"source\":\"local\"}}",
        "OS_DASHBOARD_ORIGIN": "https://kernel-mini-os.iterate.workers.dev",
        "PROJECT_APP_SESSION_SECRET": "872df450ac06f2761a5c629349804d7648dfc9e840c7d0b8ed58d657e9c44c73",
      },
      "routes": [{ "pattern": "*.shiterate.com/*", "zone_name": "shiterate.com" }],
    },

    // ---- SELF-HOST wide open / LOCAL DEV (`pnpm dev`): NO wall + kv directory ----
    // The simplest profile: omit `wall` entirely => every caller anonymous, users don't exist. This IS
    // the trivial "no-auth self-host" story — run it bare, or put your own Caddy/tunnel in front. No
    // hostBase => the first host label is the project (`acme.localhost:PORT`); a local miniflare KV means
    // create/list work fully offline, zero external dependencies. ----
    "dev": {
      "name": "kernel-dev",
      "worker_loaders": [{ "binding": "LOADER" }],
      "durable_objects": {
        "bindings": [{ "name": "STREAM_DO", "class_name": "StreamDurableObject" }],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StreamDurableObject"] }],
      "kv_namespaces": [
        { "binding": "DIRECTORY_KV", "id": "402ac6e2e34f45d38d171abb630d434d" },
        // The ingress routing table (ADR 0020/0025). Same namespace, `route:` keys (vs `project:`).
        { "binding": "ROUTING_KV", "id": "402ac6e2e34f45d38d171abb630d434d" },
        { "binding": "SECRETS_KV", "id": "402ac6e2e34f45d38d171abb630d434d" },
      ],
      "vars": {
        "APP_CONFIG": "{\"directory\":{\"provider\":\"kv\"}}",
        "PROJECT_APP_SESSION_SECRET": "872df450ac06f2761a5c629349804d7648dfc9e840c7d0b8ed58d657e9c44c73",
      },
    },

    // ---- SEPARATE CUSTOMER ACCOUNT (Jonas personal 05958…): the SAME bundle in a DIFFERENT Cloudflare
    // account — the isolation proof (ADR 0027). Wide open + kv directory, its OWN KV namespace. workers.dev
    // only for now (a burnable personal domain + route comes later). Proves same-bundle-different-account. ----
    "personal": {
      "name": "kernel-personal",
      "account_id": "05958bb7b57a2ac7eb5d3906fd3cf8bb",
      "workers_dev": true,
      "worker_loaders": [{ "binding": "LOADER" }],
      "durable_objects": {
        "bindings": [{ "name": "STREAM_DO", "class_name": "StreamDurableObject" }],
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StreamDurableObject"] }],
      "kv_namespaces": [
        { "binding": "DIRECTORY_KV", "id": "82100d0688cf4ef3801f42ec5dcd2027" },
        { "binding": "ROUTING_KV", "id": "82100d0688cf4ef3801f42ec5dcd2027" },
      ],
      "vars": {
        // hostBase mispwoso.com => <slug>.mispwoso.com is the project; Universal SSL covers one-label
        // subdomains, so no wildcard-TLS setup needed. wide open (no wall) + kv directory.
        "APP_CONFIG": "{\"hostBase\":\"mispwoso.com\",\"directory\":{\"provider\":\"kv\"}}",
        "PROJECT_APP_SESSION_SECRET": "872df450ac06f2761a5c629349804d7648dfc9e840c7d0b8ed58d657e9c44c73",
      },
      // Burnable personal domain (Jonas OK'd): reassign the existing *.mispwoso.com/* route to this worker.
      "routes": [{ "pattern": "*.mispwoso.com/*", "zone_name": "mispwoso.com" }],
    },
  },
}

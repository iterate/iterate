{
  "name": "kernel-auth",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  // CIMD fetches remote client_id metadata docs; the provider requires this flag to prove the fetch is
  // to a strictly-public URL (SSRF guard). See @cloudflare/workers-oauth-provider clientIdMetadataDocumentEnabled.
  "compatibility_flags": ["global_fetch_strictly_public"],
  // iterate (prd) POC account — same as the kernel. Never touches the production apps/os deployment.
  "account_id": "04b3b57291ef2626c6a8daa9d47065a7",
  "workers_dev": true,

  "kv_namespaces": [
    // Provider-owned: grants, access/refresh tokens, DCR clients. Required binding name.
    { "binding": "OAUTH_KV", "id": "b8efbdc3253840fa95331a80efbeb03d" },
    // Ours: the directory (users → projects → …).
    { "binding": "DIRECTORY_KV", "id": "8c5e40f237704ce68cbae2483f118c22" },
  ],

  "vars": {
    // Login backend: "email" (become the entered user) · "access" (read Cf-Access header) · "open" (anon).
    "LOGIN_MODE": "email",
    // DEMO session-signing secret. A real deploy supplies this as a Doppler-backed secret, not a var.
    "SESSION_SECRET": "b3f1c0a7d2e94f6581ac37bde90f24a15c68d7e3049fba21c5e6d8790a1b2c3d",
  },
}

{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "off",
    "suspicious": "off",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": [
    "**/.cache/",
    "**/.claude/",
    "**/.cursor/",
    "**/.husky/",
    "packages/ui/src/components/alert-dialog.tsx",
    "packages/ui/src/components/avatar.tsx",
    "packages/ui/src/components/badge.tsx",
    "packages/ui/src/components/breadcrumb.tsx",
    "packages/ui/src/components/button.tsx",
    "packages/ui/src/components/card.tsx",
    "packages/ui/src/components/checkbox.tsx",
    "packages/ui/src/components/command.tsx",
    "packages/ui/src/components/dialog.tsx",
    "packages/ui/src/components/dropdown-menu.tsx",
    "packages/ui/src/components/empty.tsx",
    "packages/ui/src/components/field.tsx",
    "packages/ui/src/components/input-group.tsx",
    "packages/ui/src/components/input.tsx",
    "packages/ui/src/components/label.tsx",
    "packages/ui/src/components/native-select.tsx",
    "packages/ui/src/components/select.tsx",
    "packages/ui/src/components/separator.tsx",
    "packages/ui/src/components/sheet.tsx",
    "packages/ui/src/components/sidebar.tsx",
    "packages/ui/src/components/skeleton.tsx",
    "packages/ui/src/components/sonner.tsx",
    "packages/ui/src/components/spinner.tsx",
    "packages/ui/src/components/table.tsx",
    "packages/ui/src/components/tabs.tsx",
    "packages/ui/src/components/textarea.tsx",
    "packages/ui/src/components/tooltip.tsx",
    "packages/ui/src/hooks/use-mobile.ts",
    "core/os/src/components/ui/avatar.tsx",
    "core/os/src/components/ui/button.tsx",
    "core/os/src/components/ui/checkbox.tsx",
    "core/os/src/components/ui/field.tsx",
    "core/os/src/components/ui/input.tsx",
    "core/os/src/components/ui/label.tsx",
    "core/os/src/components/ui/native-select.tsx",
    "core/os/src/components/ui/separator.tsx",
    "core/os/src/components/ui/spinner.tsx",
    "**/routeTree.gen.ts",
    "**/.generated/",
    "**/*.d.ts",
    "**/node_modules/",
    "**/dist/",
    "**/build/",
    "pnpm-lock.yaml",
    "test-results/**"
  ],
  "jsPlugins": [
    "./lint/oxlint-plugin-iterate.ts",
    "@tanstack/eslint-plugin-router",
    "eslint-plugin-eslint-comments",
    {
      "name": "import-js",
      "specifier": "eslint-plugin-import"
    },
    {
      "name": "unicorn-js",
      "specifier": "eslint-plugin-unicorn"
    },
    "middlewright/lint-plugin"
  ],
  "rules": {
    "constructor-super": "error",
    "for-direction": "error",
    "no-async-promise-executor": "error",
    "no-case-declarations": "error",
    "no-class-assign": "error",
    "no-compare-neg-zero": "error",
    "no-cond-assign": "error",
    "no-const-assign": "error",
    "no-constant-binary-expression": "error",
    "no-constant-condition": "error",
    "no-control-regex": "error",
    "no-debugger": "error",
    "no-delete-var": "error",
    "no-dupe-class-members": "error",
    "no-dupe-else-if": "error",
    "no-dupe-keys": "error",
    "no-duplicate-case": "error",
    "no-empty-character-class": "error",
    "no-empty-pattern": "error",
    "no-empty-static-block": "error",
    "no-ex-assign": "error",
    "no-extra-boolean-cast": "error",
    "no-fallthrough": "error",
    "no-func-assign": "error",
    "no-global-assign": "error",
    "no-import-assign": "error",
    "no-invalid-regexp": "error",
    "no-irregular-whitespace": "error",
    "no-loss-of-precision": "error",
    "no-misleading-character-class": "error",
    "no-new-native-nonconstructor": "error",
    "no-nonoctal-decimal-escape": "error",
    "no-obj-calls": "error",
    "no-prototype-builtins": "error",
    "no-regex-spaces": "error",
    "no-self-assign": "error",
    "no-setter-return": "error",
    "no-shadow-restricted-names": "error",
    "no-sparse-arrays": "error",
    "no-this-before-super": "error",
    "no-unexpected-multiline": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-negation": "error",
    "no-unsafe-optional-chaining": "error",
    "no-unused-labels": "error",
    "no-unused-private-class-members": "error",
    "no-unused-vars": "error",
    "no-useless-backreference": "error",
    "no-useless-catch": "error",
    "no-useless-escape": "error",
    "no-with": "error",
    "require-yield": "error",
    "use-isnan": "error",
    "valid-typeof": "error",
    "@tanstack/router/create-route-property-order": "warn",
    "iterate/no-capnweb-http-batch": "error",
    "iterate/import-rules": "warn",
    "iterate/no-sr-only-data-attributes": "error",
    "iterate/icon-button-has-hover-text": "error",
    "iterate/relative-import-extensions": "error",
    "iterate/zod-schema-naming": "error",
    "iterate/no-raw-durable-object-binding-access": "error",
    "iterate/no-implied-eval": "error",
    "iterate/no-single-use-helpers": "error",
    "iterate/no-shouting-constants": "error",
    "iterate/colocate-single-use-types": "error",
    "iterate/no-single-use-types": "error",
    "iterate/prefer-logical-and-spread": "error",
    "iterate/simple-truthiness-check": "error",
    "iterate/no-inferable-type-annotation": "error",
    "iterate/typed-no-floating-promises": "error",
    "iterate/mechanical-class-impl": "error",
    "iterate/no-raw-itx-get": "error",
    "prefer-const": "off",
    "iterate/prefer-const": "error",
    "unicorn-js/template-indent": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs"],
      "rules": {
        "no-unused-vars": [
          "warn",
          {
            "args": "all",
            "argsIgnorePattern": "^_",
            "caughtErrors": "all",
            "caughtErrorsIgnorePattern": "^_",
            "destructuredArrayIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "ignoreRestSiblings": true
          }
        ],
        "no-var": "error",
        "@typescript-eslint/prefer-literal-enum-member": "error",
        "@typescript-eslint/prefer-as-const": "error",
        "@typescript-eslint/prefer-enum-initializers": "error",
        "@typescript-eslint/no-inferrable-types": "error",
        "default-param-last": "error",
        "import/extensions": ["error", "ignorePackages"],
        "import-js/order": "warn",
        "eslint-comments/require-description": "error",
        "no-sequences": "error",
        "prefer-numeric-literals": "error",
        "no-new-func": "error",
        "react/only-export-components": [
          "warn",
          {
            "allowConstantExport": true
          }
        ]
      },
      "plugins": ["typescript", "import", "react", "jsx-a11y"]
    },
    {
      "files": ["**/*.tsx"],
      "rules": {
        "react-hooks/rules-of-hooks": "error",
        "react-hooks/exhaustive-deps": "warn"
      },
      "plugins": ["react"]
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "test/playwright/**/*.ts",
        "test/helpers/*.spec.ts",
        "test/helpers/auth-config.ts",
        "test/helpers/forged-session.ts",
        "test/helpers/issuer.ts",
        "test/helpers/operator.ts",
        "test/helpers/screenshot.ts",
        "test/helpers/test.ts",
        "test/helpers/worker-base-url.ts"
      ],
      "rules": {
        "iterate/helpers-after-tests": "error",
        "iterate/no-describe": "error",
        "iterate/no-lifecycle-hooks": "error",
        "iterate/no-vi-mock": "error",
        "iterate/prefer-object-property-match": "error",
        "iterate/prefer-test-over-it": "error"
      }
    },
    {
      "files": ["**/routes/**"],
      "rules": {
        "react/only-export-components": "off"
      },
      "plugins": ["react"]
    },
    {
      "files": ["packages/ui/src/components/**/*.tsx"],
      "rules": {
        "react/only-export-components": "off"
      },
      "plugins": ["react"]
    },
    {
      "files": [
        "test/playwright/**/*.ts",
        "test/helpers/*.spec.ts",
        "test/helpers/auth-config.ts",
        "test/helpers/forged-session.ts",
        "test/helpers/issuer.ts",
        "test/helpers/operator.ts",
        "test/helpers/screenshot.ts",
        "test/helpers/test.ts",
        "test/helpers/worker-base-url.ts"
      ],
      "rules": {
        "iterate/spec-restricted-syntax": "error",
        "middlewright/prefer-locator-waits": "error",
        "middlewright/prefer-positive-waits": "error",
        "middlewright/require-timeout-comment": "error",
        "no-restricted-imports": [
          "error",
          {
            "name": "@playwright/test",
            "importNames": ["test"],
            "message": "Import test from the harness at test/helpers/test.ts ('../../helpers/test.ts' from an app folder such as test/playwright/os/, '../helpers/test.ts' from test/playwright/ itself). It wraps Playwright's test with middlewright plugins (spinner waiter, hydration waiter, UI error reporter)."
          }
        ]
      }
    },
    {
      "files": [
        "test/helpers/*.spec.ts",
        "test/helpers/auth-config.ts",
        "test/helpers/forged-session.ts",
        "test/helpers/issuer.ts",
        "test/helpers/operator.ts",
        "test/helpers/screenshot.ts",
        "test/helpers/test.ts",
        "test/helpers/worker-base-url.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["packages/**", "apps/**"],
      "rules": {
        "import-js/no-restricted-paths": [
          "error",
          {
            "zones": [
              {
                "target": ["./packages/**", "./apps/**"],
                "from": "./core/os",
                "message": "The SDK and the first-party apps use the platform the way user code does: through `iterate/*`. A module user code needs belongs in core/lib; platform-only code stays in core/os. The platform's tests live in test/, which this rule does not cover (core/lib/README.md#the-sdkplatform-line)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["core/**"],
      "rules": {
        "import-js/no-restricted-paths": [
          "error",
          {
            "zones": [
              {
                "target": "./core",
                "from": "./",
                "except": ["./configs", "./core", "./node_modules"],
                "message": "core/ builds from a clone of itself (core/AGENTS.md): it imports nothing outside core/. Outside code may import core, never the reverse. The one exception until it is resolved: configs/, the project templates the build bakes in (tasks/core-minimal-template.md)."
              },
              {
                "target": "./core/lib",
                "from": "./core/os",
                "message": "The SDK and the first-party apps use the platform the way user code does: through `iterate/*`. A module user code needs belongs in core/lib; platform-only code stays in core/os. The platform's tests live in test/, which this rule does not cover (core/lib/README.md#the-sdkplatform-line)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["core/os/src/library.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**",
                  "!capnweb",
                  "!cloudflare:workers",
                  "!zod",
                  "!iterate/expression",
                  "!iterate/lib",
                  "!iterate/stream/run",
                  "!./repo/contract.ts",
                  "!./workspace/contract.ts",
                  "!./library/*.ts"
                ],
                "allowTypeImports": true,
                "message": "The library rule (core/os/src/library.ts): a library module takes `itx` and nothing else, so at runtime it imports only what a userspace worker could too: npm packages it would bundle (capnweb, cloudflare:workers, zod), the SDK's pure `iterate/expression`, `iterate/lib` and `iterate/stream/run`, the entities' contracts and the library's own files. Type-only imports are free."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["core/lib/src/stream/contract.ts", "packages/agents/src/contract.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**", "!zod", "!iterate/stream/contract", "!iterate/stream/run"],
                "allowTypeImports": true,
                "message": "A browser loads processor contracts (the Agents page reads an agent's events and state through @iterate-com/agents/contract), so at runtime a contract imports only zod, `iterate/stream/contract` and `iterate/stream/run`, never the processor engine: `iterate/stream/processor` carries causes on node:async_hooks (core/lib/src/stream/contract.ts). Type-only imports are free."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["core/os/src/library/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**",
                  "!capnweb",
                  "!cloudflare:workers",
                  "!zod",
                  "!iterate/expression",
                  "!iterate/lib",
                  "!../repo/contract.ts",
                  "!../workspace/contract.ts",
                  "!./*.ts",
                  "!../library.ts"
                ],
                "allowTypeImports": true,
                "message": "The library rule (core/os/src/library.ts): a library module takes `itx` and nothing else, so at runtime it imports only what a userspace worker could too: npm packages it would bundle (capnweb, cloudflare:workers, zod), the SDK's pure `iterate/expression` and `iterate/lib`, the entities' contracts and the library's own files. Type-only imports are free."
              }
            ]
          }
        ]
      }
    }
  ]
}

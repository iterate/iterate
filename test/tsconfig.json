{
  // The vitest suites that drive a running worker, and their helpers. They import apps/os's source,
  // which needs the Workers types, and run in Node: both sets of types, as apps/os's
  // tsconfig.tests.json. The Playwright specs' helpers are playwright/tsconfig.json's (DOM types).
  "extends": "../apps/os/tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "node", "vite/client"]
  },
  "include": ["helpers", "vitest", "vitest.config.ts"],
  "exclude": [
    "helpers/*.spec.ts",
    "helpers/auth-config.ts",
    "helpers/forged-session.ts",
    "helpers/issuer.ts",
    "helpers/operator.ts",
    "helpers/screenshot.ts",
    "helpers/test.ts",
    "helpers/worker-base-url.ts"
  ]
}

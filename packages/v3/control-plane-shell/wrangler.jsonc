{
  // The control-plane shell — the SECOND worker the project worker falls back to (self-host / hosted
  // topology). Its own package (D40, one package per worker); the deployed worker name is unchanged.
  "name": "iterate-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "account_id": "04b3b57291ef2626c6a8daa9d47065a7",
  "workers_dev": true,

  // First-party / platform secrets substituted at this outer shell (hosted). Omit for a self-host control
  // plane with no first-party keys.
  "kv_namespaces": [{ "binding": "PLATFORM_SECRETS_KV", "id": "34af8f4b5e49447f9b7bd63039a39ce3" }],

  // CROSS-SCRIPT binding (D27): the context namespace is DEFINED in project-worker; the control
  // plane binds it here (script_name → no migration) so it can write into a project's context.
  "durable_objects": {
    "bindings": [
      {
        "name": "ITERATE_CONTEXT",
        // Deploys in LOCKSTEP with (after) project-worker's rename-2 migration — the class_name
        // must match what the project-worker script currently exports.
        "class_name": "IterateContextDurableObject",
        "script_name": "project-worker",
      },
    ],
  },
}

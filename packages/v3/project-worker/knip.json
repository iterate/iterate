{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/sdk.ts",
    "src/runner-entry.ts",
    "src/client/demo.tsx",
    "specs/*.spec.ts",
    "**/*.test.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["cloudflare", "@v3/shared", "@playwright/test"],
  "ignoreBinaries": ["playwright"],
  "ignoreUnresolved": ["./cap.js", "./e2e/support/global-setup.ts"]
}

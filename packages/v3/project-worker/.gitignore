public/
# The processor SDK bundle build-sdk.mjs writes (injected into every loaded isolate) — built by every
# script that needs it and by the vitest global-setup, never committed (a 400 KB diff per SDK edit).
src/generated/
# The Vite build (vite.config.ts): dist/client (the console's bundle + public/) and
# dist/server (index.js + wrangler.json) — what `pnpm deploy` and the local lanes consume.
dist/

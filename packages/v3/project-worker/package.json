{
  "name": "project-worker",
  "private": true,
  "type": "module",
  "description": "The clean-room platform — ONE worker, one package: worker.ts (the stateless capnweb edge + ingress router) + IterateContextDurableObject (iterate-context-durable-object.ts) + control-plane.ts (OAuth AS + D1 directory + /mcp + the console's server half, always in-process) + routes/ (the console: a TanStack Start app) + context/ stream/ sdk/ client/ + lib.ts + library.ts",
  "exports": {
    "./types": "./src/types.ts",
    "./client": "./src/client/live-state.ts",
    "./app": "./src/client/browser.ts",
    "./app-server": "./src/client/app-auth.ts",
    "./app-session": "./src/browser-session.ts",
    "./dashboard": "./src/client/dashboard.tsx",
    "./dashboard-data": "./src/client/dashboard-data.ts"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "vite build",
    "deploy": "tsx scripts/deploy.ts",
    "routes:generate": "node scripts/generate-route-tree.ts",
    "routes:check": "node scripts/generate-route-tree.ts --check",
    "typecheck": "pnpm routes:check && node build-sdk.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.tests.json && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run --configLoader runner",
    "e2e": "vitest run --configLoader runner --project e2e",
    "spec": "playwright test",
    "bench": "vitest bench --configLoader runner --run --project bench",
    "db:schema:remote": "wrangler d1 execute control-plane-directory --remote --file src/control-plane.sql",
    "gen:wrangler": "tsx scripts/generate-wrangler-config.ts",
    "ensure-resources": "tsx scripts/ensure-resources.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "@tanstack/react-router": "1.168.3",
    "@tanstack/react-start": "1.167.5",
    "capnweb": "npm:@iterate-com/capnweb@^0.12.2",
    "json5": "^2.2.3",
    "pako": "^3.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.1.5",
    "oauth4webapi": "^3.8.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:cloudflare",
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@tanstack/router-generator": "1.166.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.27.4",
    "typescript": "^5.9.3",
    "undici": "^7.29.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.7",
    "wrangler": "4.127.1",
    "trpc-cli": "0.15.1",
    "tsx": "^4.20.6"
  }
}

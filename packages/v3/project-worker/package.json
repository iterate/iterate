{
  "name": "project-worker",
  "private": true,
  "type": "module",
  "description": "The clean-room capability host — ONE worker, one package: worker.ts (the stateless capnweb edge) + IterateContextDurableObject (iterate-context-durable-object.ts) + context/ fetch/ stream/ sdk/ lib/",
  "scripts": {
    "dev": "node build-sdk.mjs && wrangler dev",
    "deploy": "node build-sdk.mjs && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "node build-sdk.mjs && vitest run",
    "test:unit": "vitest run --project unit",
    "e2e": "node build-sdk.mjs && vitest run --config e2e/vitest.config.ts",
    "spec": "node build-sdk.mjs && playwright test",
    "bench": "node build-sdk.mjs && vitest bench --run --config bench/vitest.config.ts"
  },
  "exports": {
    ".": "./src/worker.ts"
  },
  "dependencies": {
    "@v3/shared": "workspace:*",
    "capnweb": "npm:@iterate-com/capnweb@^0.12.2",
    "json5": "^2.2.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7",
    "wrangler": "4.127.1"
  }
}

{
  "name": "project-worker",
  "private": true,
  "type": "module",
  "description": "The clean-room platform — ONE worker, one package: worker.ts (the stateless capnweb edge + ingress router) + IterateContextDurableObject (iterate-context-durable-object.ts) + control-plane/ (OAuth AS + D1/sqlfu directory + /mcp, always in-process) + context/ fetch/ stream/ sdk/ lib/ shared/",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "node build-sdk.mjs && tsc --noEmit && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "e2e": "vitest run --project e2e",
    "spec": "node build-sdk.mjs && playwright test",
    "bench": "vitest bench --run --project bench",
    "sqlfu:generate": "sqlfu generate",
    "db:schema:remote": "wrangler d1 execute control-plane-directory --remote --file src/control-plane/definitions.sql"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.3",
    "@modelcontextprotocol/server": "2.0.0",
    "capnweb": "npm:@iterate-com/capnweb@^0.12.2",
    "json5": "^2.2.3",
    "pako": "^3.0.1",
    "sqlfu": "0.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.4",
    "miniflare": "catalog:cloudflare",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7",
    "wrangler": "4.127.1"
  }
}

{
  "name": "project-worker",
  // The build hook regenerates the bundled processor SDK (src/generated/*) before wrangler
  // bundles src directly. (capnweb-validate was removed — no mirror, no decorators.)
  "main": "src/worker.ts",
  "build": {
    "command": "node build-sdk.mjs",
    "watch_dir": "src",
  },
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  "compatibility_date": "2026-09-01",
  // Pure-play: NO nodejs_compat (workerd/miniflare/Raspberry-Pi portability). The runner is the lean half.
  "account_id": "04b3b57291ef2626c6a8daa9d47065a7",
  "workers_dev": true,

  // The Worker Loader that runs each project's confined config worker / agents.
  "worker_loaders": [{ "binding": "LOADER" }],

  // Deploy identity. Loader isolates are cached ACROSS deployments, but a DO is durable and
  // survives redeploys — so a facet built from an isolate minted by a PRIOR deployment can't be
  // called from the new parent ("Durable Object Facet stubs cannot be transferred between Workers").
  // apps/os folds workerVersion(env)=CF_VERSION_METADATA.id into its loader cacheKey to prevent
  // exactly this; the clean room does the same (see confinedWorker in core/worker-loader.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // THE context DO: one per {projectId, path}, codec-named — the stream, the routing table, and
  // every hibernatable socket in one addressable parent.
  "durable_objects": {
    "bindings": [{ "name": "CONTEXT", "class_name": "IterateContextDurableObject" }],
  },
  // RESET (2026-08-29): the worker + its DOs were destroyed and redeployed from a clean slate, so
  // the old v1→v8 chain (which renamed classes that never exist in a fresh namespace) is dead
  // history — collapsed to ONE fresh migration for the sole live class. This mirrors what
  // wrangler.test.jsonc always did for fresh pool storage. prod is resettable by design.
  // rename-2 (2026-09-01): the class renames to IterateContextDurableObject IN PLACE — a DO class
  // rename is a DEPLOY EVENT (renamed_classes migration), so the deployed namespace keeps its data.
  "migrations": [
    { "tag": "reset-1", "new_sqlite_classes": ["StreamDurableObject"] },
    {
      "tag": "rename-2",
      "renamed_classes": [{ "from": "StreamDurableObject", "to": "IterateContextDurableObject" }],
    },
  ],

  // The DO's fallback (target-core §4.4). SELF-HOST/HOSTED: a service binding to the real control-plane shell
  // worker (deployed from packages/v3/control-plane-shell). SOLO would instead bind
  // { service: "project-worker", entrypoint: "DummyControlPlane" } (this worker's own loopback).
  "services": [
    {
      "binding": "FALLBACK",
      "service": "iterate-control-plane",
      "entrypoint": "ControlPlaneShell",
    },
  ],

  // Per-project secret store behind the egress door (secret:<projectId>:<name>). Proves the middleware
  // rebuilds a WS-upgrade Request to substitute a header without breaking the 101 (target-core §6.0 risk #4).
  "kv_namespaces": [
    { "binding": "SECRETS_KV", "id": "6df3b8c18a624d078d1a1da66f3251c0" },
    // itx.kv backing — project-prefixed (the D8 portability proof point).
    { "binding": "ITX_KV", "id": "08df862920b04446b3503c22f9888b04" },
  ],

  // APP_CONFIG omitted → SOLO default (fallback → this worker's own DummyControlPlane loopback).
  "vars": {},
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-worker",
  // The build hook regenerates the bundled processor SDK (src/generated/*) before wrangler
  // bundles src directly. (capnweb-validate was removed — no mirror, no decorators.)
  "main": "src/worker.ts",
  "build": {
    "command": "node build-sdk.mjs",
    "watch_dir": "src",
  },
  // At this date nodejs_compat is ON by default for THIS worker (harmless: nothing here imports
  // node:*). Loaded userspace isolates are the pure-play half — context/worker-loader.ts mints them
  // with no_nodejs_compat, so what runs inside a context stays portable across workerd builds.
  "compatibility_date": "2026-09-01",
  // allow_irrevocable_stub_storage (experimental, undocumented): lets loaded code STORE its env.ITX
  // stub in its own durable storage and replay it (e2e/facets-persistent-stub.e2e.test.ts pins it); every worker
  // in the chain needs it, so the loaded isolates carry it too (context/worker-loader.ts).
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  "account_id": "04b3b57291ef2626c6a8daa9d47065a7",
  "observability": { "enabled": true, "logs": { "head_sampling_rate": 1 } },
  "workers_dev": true,
  // PROJECT HOSTS (src/project-host.ts): every `<label>--<projectId>.<base>` under the wildcard is
  // an app of that project. The wildcard DNS record (`*.project-worker.iterate.com` AAAA 100::,
  // proxied — originless, the route terminates it) lives in the zone; the route is this line.
  "routes": [{ "pattern": "*.project-worker.iterate.com/*", "zone_name": "iterate.com" }],

  // A capnweb WebSocket session is pumped by ONE long-lived stateless invocation, and every
  // edge->DO `invoke` it makes is a subrequest counted against that one invocation for the session's
  // whole life — so the 10,000 paid default is hit by an ordinary long-lived client (3 appends/s for
  // ~1 h). Raise the ceiling; only subrequests actually made are billed, so this costs nothing until
  // used. (The durable fix is client-side batching/reconnect — docs/perf learnings F-subreq.)
  // subrequests: a long-lived capnweb WS session accumulates against its one pump invocation (above).
  // cpu_ms: a cold re-reduce over a long log, or a large per-commit fan-out, is CPU-bound on the DO's
  // single thread; 5 min (the paid max) gives 10x the 30 s default before a CPU-limit abort. Neither
  // is billed until used.
  "limits": { "subrequests": 1000000, "cpu_ms": 300000 },

  // The hosted /demo page as a static asset (build-sdk.mjs writes public/demo.html): served by the
  // platform, not the script — 255 KiB fewer in every /api and DO isolate.
  "assets": { "directory": "./public" },

  // The Worker Loader that runs each project's confined config worker / agents.
  "worker_loaders": [{ "binding": "LOADER" }],
  // Workers AI, exposed VERBATIM as the built-in root `itx.ai` (context/built-ins.ts).
  "ai": { "binding": "AI" },
  // Cloudflare Artifacts ("git for agents", beta) — the ONE bound namespace, project-scoped as the
  // built-in root `itx.cfArtifacts` (context/built-ins.ts forces every repo name under `${projectId}.`).
  // repo-create auto-provisions the namespace; ARTIFACTS_ACCOUNT_ID/NAMESPACE below build git remotes.
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "project-worker-repos" }],

  // Deploy identity. Loader isolates are cached ACROSS deployments, but a DO is durable and
  // survives redeploys — so a facet built from an isolate minted by a PRIOR deployment can't be
  // called from the new parent ("Durable Object Facet stubs cannot be transferred between Workers").
  // apps/os folds workerVersion(env)=CF_VERSION_METADATA.id into its loader cacheKey to prevent
  // exactly this; the clean room does the same (see confinedWorker in context/worker-loader.ts).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // THE context DO: one per {projectId, path}, codec-named — the stream, the routing table, and
  // every hibernatable socket in one addressable parent.
  "durable_objects": {
    "bindings": [{ "name": "ITERATE_CONTEXT", "class_name": "IterateContextDurableObject" }],
  },
  // The DO's lifecycle, declaratively: one SQLite-backed class, no migration history to replay
  // (the legacy `migrations` array is gone; a deployed namespace keeps its data across this change).
  "exports": {
    "IterateContextDurableObject": { "type": "durable-object", "storage": "sqlite" },
    // The pre-rename class (StreamDurableObject → IterateContextDurableObject, clean-room C2) still
    // had a provisioned namespace on workers.dev; wrangler refuses to deploy over an orphan, so it is
    // retired here — a tombstone, its data gone with it (the clean room's deployment is resettable).
    "StreamDurableObject": { "type": "durable-object", "state": "deleted" },
  },

  // The control plane runs IN-PROCESS now (src/control-plane) — no fallback worker. The directory
  // (projects/orgs/slugs/routes/api-keys) is a D1; egress + admission are in-process.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "control-plane-directory",
      "database_id": "fb3502bf-da4c-42e7-8e70-6f75765f7a4d",
    },
  ],

  // Per-project secret store behind the egress door (secret:<projectId>:<name>). Proves the middleware
  // rebuilds a WS-upgrade Request to substitute a header without breaking the 101 (target-core §6.0 risk #4).
  // OAUTH_KV = the in-process OAuth AS's provider store (grants/tokens/DCR clients).
  "kv_namespaces": [
    { "binding": "SECRETS_KV", "id": "6df3b8c18a624d078d1a1da66f3251c0" },
    // itx.kv backing — project-prefixed (the D8 portability proof point).
    { "binding": "ITX_KV", "id": "08df862920b04446b3503c22f9888b04" },
    { "binding": "OAUTH_KV", "id": "b8efbdc3253840fa95331a80efbeb03d" },
  ],

  // Configuration (src/app-config.ts): `APP_CONFIG_*` vars, parsed once per isolate, loud on a bad one.
  // Bindings are declared above; a var is what differs between deployments of the same code. The
  // SOLO/test topology rebinds FALLBACK in wrangler.test.jsonc and e2e/support/solo-config.ts.
  "vars": {
    "APP_CONFIG_ENVIRONMENT_NAME": "poc",
    "APP_CONFIG_PROJECT_HOSTNAME_BASE": "project-worker.iterate.com",
    // The Artifacts git remote is `https://<ACCOUNT_ID>.artifacts.cloudflare.net/git/<NAMESPACE>/<repo>.git`
    // — the `itx.repos` layer builds it from these when it does git over HTTPS.
    "ARTIFACTS_ACCOUNT_ID": "04b3b57291ef2626c6a8daa9d47065a7",
    "ARTIFACTS_NAMESPACE": "project-worker-repos",
    // The in-process control plane: `open` = the no-login floor (this pass's stub); a committed demo
    // session secret (Doppler-backed in a real deploy). PLATFORM_SECRETS_KV stays unbound (self-host
    // passthrough) until the hosted platform binds it.
    "LOGIN_MODE": "open",
    "SESSION_SECRET": "b3f1c0a7d2e94f6581ac37bde90f24a15c68d7e3049fba21c5e6d8790a1b2c3d",
  },
}

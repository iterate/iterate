{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "ESNext.Disposable"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["src"],
  // The console (the TanStack Start routes, the router, the generated tree) and the browser demo are
  // React + DOM: checked by tsconfig.client.json, not here (workerd-typed, no DOM/JSX on purpose).
  "exclude": ["src/routes", "src/router.tsx", "src/routeTree.gen.ts", "src/client/demo.tsx"]
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iterate-v4-test",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ITERATE_CONTEXT",
        "class_name": "IterateContextDurableObject",
      },
    ],
  },
  "exports": {
    "IterateContextDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "services": [
    {
      "binding": "FALLBACK",
      "service": "iterate-v4-test",
      "entrypoint": "DummyControlPlane",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SECRETS_KV",
    },
    {
      "binding": "ITX_KV",
    },
  ],
  "vars": {
    "APP_CONFIG_ENVIRONMENT_NAME": "test",
  },
}

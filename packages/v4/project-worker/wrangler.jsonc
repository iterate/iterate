{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iterate-v4-simplification",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["allow_irrevocable_stub_storage"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "build": {
    "command": "node build-sdk.mjs",
    "watch_dir": "src",
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ITERATE_CONTEXT",
        "class_name": "IterateContextDurableObject",
      },
    ],
  },
  "exports": {
    "IterateContextDurableObject": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "services": [
    { "binding": "BUNDLER", "service": "iterate-v4-simplification-bundler" },
    {
      "binding": "FALLBACK",
      "service": "iterate-v4-simplification",
      "entrypoint": "DummyControlPlane",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "SECRETS_KV",
    },
    {
      "binding": "ITX_KV",
    },
  ],
  "vars": {
    "APP_CONFIG_ENVIRONMENT_NAME": "v4-local",
  },
}

{
  // Worker code typed against the Cloudflare types (the linter runs as a loaded Durable Object), and
  // tests that read their fixtures in Node.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src", "tsdown.config.ts", "vitest.config.ts"]
}

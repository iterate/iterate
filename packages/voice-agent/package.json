{
  "name": "@iterate-com/voice-agent",
  "version": "0.1.0",
  "description": "The realtime voice agent for iterate projects. A config repo declares this package and re-exports the agent from a three-line voice-agent.ts; the platform builds that file as a guest worker. VoiceAgentApp gives the project worker a partial fetch for the voice app slug plus setup and remove; the worker refs and installer let a CLI or a phone enable and dial it.",
  "keywords": [
    "iterate",
    "voice",
    "realtime",
    "grok",
    "openai",
    "cloudflare-workers",
    "durable-objects"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iterate/iterate",
    "directory": "packages/voice-agent"
  },
  "homepage": "https://github.com/iterate/iterate/tree/main/packages/voice-agent#readme",
  "bugs": {
    "url": "https://github.com/iterate/iterate/issues"
  },
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./worker": {
        "types": "./dist/worker.d.ts",
        "import": "./dist/worker.mjs",
        "default": "./dist/worker.mjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "INSTALL.md",
    "HEAD_AUDIO_LICENSE.txt"
  ],
  "scripts": {
    "build": "rm -rf dist && tsdown && tsc -p tsconfig.dts.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=default --reporter=../shared/src/test-support/e2e-policy/retry-telemetry-reporter.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "iterate": ">=0.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:cloudflare",
    "iterate": "workspace:*",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3",
    "vitest": "4.0.15"
  }
}

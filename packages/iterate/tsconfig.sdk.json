{
  // Declaration emit for the `iterate/sdk` export. tsdown's dts pipeline
  // (rolldown-plugin-dts → @babel/generator) crashes on the generated itx
  // contract's getter signatures, so sdk declarations are emitted with plain
  // tsc instead (see the sdk entry in tsdown.config.ts + the build script).
  "files": [
    "src/sdk.ts",
    "src/client.ts",
    "src/live-state.ts",
    "src/node.ts",
    "src/processors/index.ts",
    "src/processors/testing.ts",
    "src/react.ts",
    "src/cloudflare-workers.d.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The itx client sources use `.ts`-suffixed relative imports (the package
    // convention); legal under emitDeclarationOnly, and the emitted d.ts keeps
    // the .ts specifiers, which consumers resolve to the sibling .d.ts.
    "rewriteRelativeImportExtensions": true,
    "lib": ["ESNext", "DOM"],
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "types": ["node"],
    // The client/react graphs pull capnweb + TanStack d.ts, which do not pass
    // a full lib check (same posture as the package tsconfig).
    "skipLibCheck": true
  }
}

{
  // Declaration emit for the `iterate/sdk` export. tsdown's dts pipeline
  // (rolldown-plugin-dts → @babel/generator) crashes on the generated itx
  // contract's getter signatures, so sdk declarations are emitted with plain
  // tsc instead (see the sdk entry in tsdown.config.ts + the build script).
  "files": ["src/sdk.ts", "src/cloudflare-workers.d.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "ESNext.Disposable", "DOM"],
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    // capnweb's published declarations use variadic tuple syntax that TS 5.9
    // rejects internally. Source and emitted SDK declarations remain checked;
    // this skips only dependency declaration bodies.
    "skipLibCheck": true,
    "types": ["node"]
  }
}

{
  // The Node entries' declarations: `iterate/node` and `iterate/stream/test-support` (node:sqlite).
  "files": ["src/node.ts", "src/stream/test-support.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  }
}

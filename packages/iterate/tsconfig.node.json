{
  // The Node entries (`iterate/node`, `iterate/stream/test-support`), the tests and the build and
  // test configs. The tests import the SDK, so the Cloudflare types stay.
  "extends": "./tsconfig.json",
  "compilerOptions": { "types": ["@cloudflare/workers-types/experimental", "node"] },
  "include": [
    "src/node.ts",
    "src/stream/test-support.ts",
    "src/test-support",
    "src/**/*.test.*",
    "tsdown.config.ts",
    "vitest.config.ts"
  ],
  "exclude": []
}

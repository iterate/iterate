{
  // The SDK unit tests, with tsconfig.worker.json's Worker settings (vitest runs them untyped).
  "extends": "./tsconfig.worker.json",
  "files": [],
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "src/test-support"],
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "emitDeclarationOnly": false,
    "types": ["@cloudflare/workers-types/experimental", "node"]
  }
}

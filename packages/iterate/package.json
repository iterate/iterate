{
  "name": "iterate",
  "version": "0.4.0",
  "description": "SDK for Iterate",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iterate/iterate",
    "directory": "packages/iterate"
  },
  "homepage": "https://github.com/iterate/iterate#readme",
  "bugs": {
    "url": "https://github.com/iterate/iterate/issues"
  },
  "keywords": [
    "iterate",
    "sdk",
    "capnweb"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "exports": {
    "./sdk": "./src/sdk/index.ts",
    "./app": "./src/app.ts",
    "./app-server": "./src/app-server.ts",
    "./app-session": "./src/app-session.ts",
    "./client": "./src/client/live-state.ts",
    "./react": "./src/client/react.tsx",
    "./api": "./src/api.ts",
    "./lib": "./src/lib.ts",
    "./expression": "./src/expression.ts",
    "./principal": "./src/principal.ts",
    "./stream/processor": "./src/stream/processor.ts",
    "./stream/test-support": "./src/stream/test-support.ts",
    "./oauth-scopes": "./src/oauth-scopes.ts",
    "./project-ingress": "./src/project-ingress.ts",
    "./oauth": "./src/client/oauth.ts",
    "./stream/run": "./src/stream/run.ts",
    "./node": "./src/node.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./sdk": {
        "types": "./dist/sdk/index.d.ts",
        "import": "./dist/sdk.mjs"
      },
      "./app": {
        "types": "./dist/app.d.ts",
        "import": "./dist/app.mjs"
      },
      "./app-server": {
        "types": "./dist/app-server.d.ts",
        "import": "./dist/app-server.mjs"
      },
      "./app-session": {
        "types": "./dist/app-session.d.ts",
        "import": "./dist/app-session.mjs"
      },
      "./client": {
        "types": "./dist/client/live-state.d.ts",
        "import": "./dist/client.mjs"
      },
      "./react": {
        "types": "./dist/client/react.d.ts",
        "import": "./dist/react.mjs"
      },
      "./api": {
        "types": "./dist/api.d.ts",
        "import": "./dist/api.mjs"
      },
      "./lib": {
        "types": "./dist/lib.d.ts",
        "import": "./dist/lib.mjs"
      },
      "./expression": {
        "types": "./dist/expression.d.ts",
        "import": "./dist/expression.mjs"
      },
      "./principal": {
        "types": "./dist/principal.d.ts",
        "import": "./dist/principal.mjs"
      },
      "./stream/processor": {
        "types": "./dist/stream/processor.d.ts",
        "import": "./dist/stream/processor.mjs"
      },
      "./stream/test-support": {
        "types": "./dist/stream/test-support.d.ts",
        "import": "./dist/stream/test-support.mjs"
      },
      "./oauth-scopes": {
        "types": "./dist/oauth-scopes.d.ts",
        "import": "./dist/oauth-scopes.mjs"
      },
      "./project-ingress": {
        "types": "./dist/project-ingress.d.ts",
        "import": "./dist/project-ingress.mjs"
      },
      "./oauth": {
        "types": "./dist/client/oauth.d.ts",
        "import": "./dist/oauth.mjs"
      },
      "./stream/run": {
        "types": "./dist/stream/run.d.ts",
        "import": "./dist/stream/run.mjs",
        "default": "./dist/stream/run.mjs"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.mjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --reporter=default --reporter=../shared/src/test-support/e2e-policy/retry-telemetry-reporter.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "capnweb": "npm:@iterate-com/capnweb@0.12.3",
    "json5": "^2.2.3",
    "oauth4webapi": "^3.8.5",
    "zod": "4.5.4",
    "ws": "8.19.0"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:cloudflare",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "react": "^19.2.7",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3",
    "vitest": "4.0.15",
    "@types/ws": "^8.18.1"
  }
}

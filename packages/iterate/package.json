{
  "name": "iterate",
  "version": "0.3.0",
  "description": "CLI and SDK for iterate",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iterate/iterate",
    "directory": "packages/iterate"
  },
  "homepage": "https://github.com/iterate/iterate#readme",
  "bugs": {
    "url": "https://github.com/iterate/iterate/issues"
  },
  "keywords": [
    "iterate",
    "cli",
    "orpc"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "iterate": "./bin/iterate.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./node": "./src/node.ts",
    "./github-ai-linter": "./src/github-ai-linter/index.ts",
    "./github-ai-linter/worker": "./src/github-ai-linter/worker.ts",
    "./guestbook": "./src/guestbook/index.ts",
    "./guestbook/client": "./src/guestbook/client.tsx",
    "./guestbook/configured-worker": "./src/guestbook/configured-worker.ts",
    "./todo": "./src/todo/index.ts",
    "./processors": "./src/processors/index.ts",
    "./processors/cloudflare": "./src/processors/cloudflare.ts",
    "./processors/testing": "./src/processors/testing.ts",
    "./sdk": "./src/sdk.ts",
    "./sdk/capnweb": "./src/sdk/capnweb/index.ts",
    "./sdk/capnweb/react": "./src/sdk/capnweb/react.tsx",
    "./sdk/itx/react": "./src/sdk/itx/react.ts",
    "./worker": "./src/worker.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.mjs",
        "default": "./dist/client.mjs"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.mjs",
        "default": "./dist/node.mjs"
      },
      "./github-ai-linter": {
        "types": "./dist/github-ai-linter/index.d.ts",
        "import": "./dist/github-ai-linter/index.mjs",
        "default": "./dist/github-ai-linter/index.mjs"
      },
      "./github-ai-linter/worker": {
        "types": "./dist/github-ai-linter/worker.d.ts",
        "import": "./dist/github-ai-linter/worker.mjs",
        "default": "./dist/github-ai-linter/worker.mjs"
      },
      "./guestbook": {
        "types": "./dist/guestbook/index.d.ts",
        "import": "./dist/guestbook/index.mjs",
        "default": "./dist/guestbook/index.mjs"
      },
      "./guestbook/client": {
        "types": "./dist/guestbook/client.d.ts",
        "import": "./dist/guestbook/client.mjs",
        "default": "./dist/guestbook/client.mjs"
      },
      "./guestbook/configured-worker": {
        "types": "./dist/guestbook/worker.d.ts",
        "import": "./dist/guestbook/configured-worker.mjs",
        "default": "./dist/guestbook/configured-worker.mjs"
      },
      "./todo": {
        "types": "./dist/todo/index.d.ts",
        "import": "./dist/todo/index.mjs",
        "default": "./dist/todo/index.mjs"
      },
      "./processors": {
        "types": "./dist/processors/index.d.ts",
        "import": "./dist/processors.mjs",
        "default": "./dist/processors.mjs"
      },
      "./processors/cloudflare": {
        "types": "./dist/processors/cloudflare.d.ts",
        "import": "./dist/processors-cloudflare.mjs",
        "default": "./dist/processors-cloudflare.mjs"
      },
      "./processors/testing": {
        "types": "./dist/processors/testing.d.ts",
        "import": "./dist/processors-testing.mjs",
        "default": "./dist/processors-testing.mjs"
      },
      "./sdk": {
        "types": "./dist/sdk.d.ts",
        "import": "./dist/sdk.mjs",
        "default": "./dist/sdk.mjs"
      },
      "./sdk/capnweb": {
        "types": "./dist/sdk/capnweb/index.d.ts",
        "import": "./dist/sdk/capnweb.mjs",
        "default": "./dist/sdk/capnweb.mjs"
      },
      "./sdk/capnweb/react": {
        "types": "./dist/sdk/capnweb/react.d.ts",
        "import": "./dist/sdk/capnweb/react.mjs",
        "default": "./dist/sdk/capnweb/react.mjs"
      },
      "./sdk/itx/react": {
        "types": "./dist/sdk/itx/react.d.ts",
        "import": "./dist/sdk/itx/react.mjs",
        "default": "./dist/sdk/itx/react.mjs"
      },
      "./worker": {
        "types": "./dist/worker.d.mts",
        "import": "./dist/worker.mjs",
        "default": "./dist/worker.mjs"
      }
    }
  },
  "files": [
    "bin",
    "dist",
    "menubar",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown --config tsdown.app-clients.config.ts && tsx scripts/check-guestbook-client-bundle.ts && tsx scripts/check-todo-client-bundle.ts && tsdown && tsx scripts/check-github-ai-linter-bundle.ts && tsx scripts/check-guestbook-bundle.ts && tsx scripts/check-todo-bundle.ts && tsc -p tsconfig.sdk.json",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --reporter=default --reporter=../shared/src/test-support/e2e-policy/retry-telemetry-reporter.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@iterate-com/capnweb": "^0.10.0",
    "@orpc/client": "1.13.14",
    "@orpc/server": "1.13.14",
    "@tanstack/react-query": "^5.101.2",
    "minimatch": "^10.2.4",
    "react": "^19.2.7",
    "sqlfu": "0.1.1",
    "trpc-cli": "0.15.1",
    "ws": "8.19.0",
    "yaml": "^2.8.3",
    "zod": "4.3.6"
  },
  "optionalDependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/react": "0.4.5"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "octokit": "^5.0.5",
    "react": "^19.1.0"
  },
  "peerDependenciesMeta": {
    "octokit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iterate-com/ui": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "jsdom": "27.4.0",
    "octokit": "^5.0.5",
    "react-dom": "^19.2.7",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3",
    "vitest": "4.0.15"
  }
}

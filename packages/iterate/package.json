    "@orpc/client": "1.13.14",
    "@orpc/server": "1.13.14",
    "@tanstack/react-query": "^5.101.2",
    "approx-string-match": "^2.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^19.2.7",
    "sqlfu": "0.1.1",

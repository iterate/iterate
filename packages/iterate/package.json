{
  "name": "iterate",
  "version": "0.3.0",
  "description": "CLI and SDK for iterate",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iterate/iterate",
    "directory": "packages/iterate"
  },
  "homepage": "https://github.com/iterate/iterate#readme",
  "bugs": {
    "url": "https://github.com/iterate/iterate/issues"
  },
  "keywords": [
    "iterate",
    "cli",
    "orpc"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "iterate": "./bin/iterate.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./live-state": "./src/live-state.ts",
    "./node": "./src/node.ts",
    "./react": "./src/react.ts",
    "./sdk": "./src/sdk.ts",
    "./worker": "./src/worker.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.mjs",
        "default": "./dist/client.mjs"
      },
      "./live-state": {
        "types": "./dist/live-state.d.ts",
        "import": "./dist/live-state.mjs",
        "default": "./dist/live-state.mjs"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.mjs",
        "default": "./dist/node.mjs"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.mjs",
        "default": "./dist/react.mjs"
      },
      "./sdk": {
        "types": "./dist/sdk.d.ts",
        "import": "./dist/sdk.mjs",
        "default": "./dist/sdk.mjs"
      },
      "./worker": {
        "types": "./dist/worker.d.mts",
        "import": "./dist/worker.mjs",
        "default": "./dist/worker.mjs"
      }
    }
  },
  "files": [
    "bin",
    "dist",
    "menubar",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.sdk.json",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@opentui/core": "0.1.102",
    "@opentui/react": "0.1.102",
    "@orpc/client": "1.13.14",
    "@orpc/server": "1.13.14",
    "@tanstack/react-query": "^5.91.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "capnweb": "https://github.com/iterate/capnweb/releases/download/v0.8.0-websocket.1/capnweb-0.8.0.tgz",
    "octokit": "^5.0.5",
    "react": "^19.2.0",
    "trpc-cli": "0.15.1",
    "ws": "8.19.0",
    "zod": "4.1.12"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@iterate-com/ui": "workspace:*",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "27.4.0",
    "react-dom": "^19.2.7",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3",
    "vitest": "4.0.15"
  }
}

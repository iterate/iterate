{
  "name": "iterate",
  "version": "0.3.0",
  "description": "SDK for the Iterate context platform",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iterate/iterate",
    "directory": "packages/iterate"
  },
  "homepage": "https://github.com/iterate/iterate#readme",
  "bugs": {
    "url": "https://github.com/iterate/iterate/issues"
  },
  "keywords": [
    "iterate",
    "sdk",
    "capnweb"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "exports": {
    "./next/sdk": "./src/next/sdk/index.ts",
    "./next/app": "./src/next/app.ts",
    "./next/app-server": "./src/next/app-server.ts",
    "./next/app-session": "./src/next/app-session.ts",
    "./next/client": "./src/next/client/live-state.ts",
    "./next/react": "./src/next/client/react.tsx",
    "./next/api": "./src/next/api.ts",
    "./next/lib": "./src/next/lib.ts",
    "./next/expression": "./src/next/expression.ts",
    "./next/principal": "./src/next/principal.ts",
    "./next/stream/processor": "./src/next/stream/processor.ts",
    "./next/oauth-scopes": "./src/next/oauth-scopes.ts",
    "./next/project-ingress": "./src/next/project-ingress.ts",
    "./next/oauth": "./src/next/client/oauth.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./next/sdk": {
        "types": "./dist/next/sdk/index.d.ts",
        "import": "./dist/next/sdk.mjs"
      },
      "./next/app": {
        "types": "./dist/next/app.d.ts",
        "import": "./dist/next/app.mjs"
      },
      "./next/app-server": {
        "types": "./dist/next/app-server.d.ts",
        "import": "./dist/next/app-server.mjs"
      },
      "./next/app-session": {
        "types": "./dist/next/app-session.d.ts",
        "import": "./dist/next/app-session.mjs"
      },
      "./next/client": {
        "types": "./dist/next/client/live-state.d.ts",
        "import": "./dist/next/client.mjs"
      },
      "./next/react": {
        "types": "./dist/next/client/react.d.ts",
        "import": "./dist/next/react.mjs"
      },
      "./next/api": {
        "types": "./dist/next/api.d.ts",
        "import": "./dist/next/api.mjs"
      },
      "./next/lib": {
        "types": "./dist/next/lib.d.ts",
        "import": "./dist/next/lib.mjs"
      },
      "./next/expression": {
        "types": "./dist/next/expression.d.ts",
        "import": "./dist/next/expression.mjs"
      },
      "./next/principal": {
        "types": "./dist/next/principal.d.ts",
        "import": "./dist/next/principal.mjs"
      },
      "./next/stream/processor": {
        "types": "./dist/next/stream/processor.d.ts",
        "import": "./dist/next/stream/processor.mjs"
      },
      "./next/oauth-scopes": {
        "types": "./dist/next/oauth-scopes.d.ts",
        "import": "./dist/next/oauth-scopes.mjs"
      },
      "./next/project-ingress": {
        "types": "./dist/next/project-ingress.d.ts",
        "import": "./dist/next/project-ingress.mjs"
      },
      "./next/oauth": {
        "types": "./dist/next/client/oauth.d.ts",
        "import": "./dist/next/oauth.mjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.next.json",
    "typecheck": "tsc --noEmit -p tsconfig.next.json",
    "test": "vitest run --reporter=default --reporter=../shared/src/test-support/e2e-policy/retry-telemetry-reporter.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "capnweb": "npm:@iterate-com/capnweb@0.12.2",
    "json5": "^2.2.3",
    "oauth4webapi": "^3.8.5",
    "react": "^19.2.7",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260831.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.4",
    "jsdom": "27.4.0",
    "react-dom": "^19.2.7",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3",
    "vitest": "4.0.15"
  }
}

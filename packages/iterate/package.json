{
  "name": "iterate",
  "version": "0.3.0",
  "description": "CLI and SDK for iterate",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iterate/iterate",
    "directory": "packages/iterate"
  },
  "homepage": "https://github.com/iterate/iterate#readme",
  "bugs": {
    "url": "https://github.com/iterate/iterate/issues"
  },
  "keywords": [
    "iterate",
    "cli",
    "orpc"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "iterate": "./bin/iterate.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./durable-object-processor-durability": "./src/durable-object-processor-durability.ts",
    "./live-state": "./src/live-state.ts",
    "./live-state-diff": "./src/live-state-diff.ts",
    "./live-state-protocol": "./src/live-state-protocol.ts",
    "./processor-contracts": "./src/processor-contracts.ts",
    "./processor-host-capabilities": "./src/processor-host-capabilities.ts",
    "./rpc-retain": "./src/rpc-retain.ts",
    "./sdk": "./src/sdk.ts",
    "./stream-events": "./src/stream-events.ts",
    "./stream-processor": "./src/stream-processor.ts",
    "./stream-processor-keepalive": "./src/stream-processor-keepalive.ts",
    "./stream-processor-registry": "./src/stream-processor-registry.ts",
    "./stream-processor-revival": "./src/stream-processor-revival.ts",
    "./stream-processor-runner": "./src/stream-processor-runner.ts",
    "./stream-runtime-metrics": "./src/stream-runtime-metrics.ts",
    "./subscriber-metrics": "./src/subscriber-metrics.ts",
    "./worker": "./src/worker.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.mts"
      },
      "./durable-object-processor-durability": {
        "import": "./dist/durable-object-processor-durability.mjs",
        "types": "./dist/durable-object-processor-durability.d.ts"
      },
      "./live-state": {
        "import": "./dist/live-state.mjs",
        "types": "./dist/live-state.d.ts"
      },
      "./live-state-diff": {
        "import": "./dist/live-state-diff.mjs",
        "types": "./dist/live-state-diff.d.ts"
      },
      "./live-state-protocol": {
        "import": "./dist/live-state-protocol.mjs",
        "types": "./dist/live-state-protocol.d.ts"
      },
      "./processor-contracts": {
        "import": "./dist/processor-contracts.mjs",
        "types": "./dist/processor-contracts.d.ts"
      },
      "./processor-host-capabilities": {
        "import": "./dist/processor-host-capabilities.mjs",
        "types": "./dist/processor-host-capabilities.d.ts"
      },
      "./rpc-retain": {
        "import": "./dist/rpc-retain.mjs",
        "types": "./dist/rpc-retain.d.ts"
      },
      "./sdk": {
        "import": "./dist/sdk.mjs",
        "types": "./dist/sdk.d.ts"
      },
      "./stream-events": {
        "import": "./dist/stream-events.mjs",
        "types": "./dist/stream-events.d.ts"
      },
      "./stream-processor": {
        "import": "./dist/stream-processor.mjs",
        "types": "./dist/stream-processor.d.ts"
      },
      "./stream-processor-keepalive": {
        "import": "./dist/stream-processor-keepalive.mjs",
        "types": "./dist/stream-processor-keepalive.d.ts"
      },
      "./stream-processor-registry": {
        "import": "./dist/stream-processor-registry.mjs",
        "types": "./dist/stream-processor-registry.d.ts"
      },
      "./stream-processor-revival": {
        "import": "./dist/stream-processor-revival.mjs",
        "types": "./dist/stream-processor-revival.d.ts"
      },
      "./stream-processor-runner": {
        "import": "./dist/stream-processor-runner.mjs",
        "types": "./dist/stream-processor-runner.d.ts"
      },
      "./stream-runtime-metrics": {
        "import": "./dist/stream-runtime-metrics.mjs",
        "types": "./dist/stream-runtime-metrics.d.ts"
      },
      "./subscriber-metrics": {
        "import": "./dist/subscriber-metrics.mjs",
        "types": "./dist/subscriber-metrics.d.ts"
      },
      "./worker": {
        "import": "./dist/worker.mjs",
        "types": "./dist/worker.d.mts"
      }
    }
  },
  "files": [
    "bin",
    "dist",
    "menubar",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.sdk.json",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@opentui/core": "0.1.102",
    "@opentui/react": "0.1.102",
    "@orpc/client": "1.13.14",
    "@orpc/server": "1.13.14",
    "@types/node": "^22.0.0",
    "capnweb": "^0.8.0",
    "octokit": "^5.0.5",
    "react": "^19.2.7",
    "trpc-cli": "0.15.1",
    "ws": "8.19.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@iterate-com/ui": "workspace:*",
    "@types/react": "^19.2.17",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3",
    "vitest": "4.0.15"
  }
}

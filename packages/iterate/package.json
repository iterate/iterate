{
  "name": "iterate",
  "version": "0.4.0",
  "description": "SDK for Iterate",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iterate/iterate",
    "directory": "packages/iterate"
  },
  "homepage": "https://github.com/iterate/iterate#readme",
  "bugs": {
    "url": "https://github.com/iterate/iterate/issues"
  },
  "keywords": [
    "iterate",
    "sdk",
    "capnweb"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "exports": {
    "./sdk": "./src/sdk/index.ts",
    "./app": "./src/app.ts",
    "./app-server": "./src/app-server.ts",
    "./app-session": "./src/app-session.ts",
    "./client": "./src/client/live-state.ts",
    "./react": "./src/client/react.tsx",
    "./api": "./src/api.ts",
    "./lib": "./src/lib.ts",
    "./expression": "./src/expression.ts",
    "./principal": "./src/principal.ts",
    "./stream/processor": "./src/stream/processor.ts",
    "./stream/test-support": "./src/stream/test-support.ts",
    "./oauth-scopes": "./src/oauth-scopes.ts",
    "./project-ingress": "./src/project-ingress.ts",
    "./oauth": "./src/client/oauth.ts",
    "./stream/run": "./src/stream/run.ts",
    "./with-itx": "./src/sdk/record-pipelined-steps.ts",
    "./node": "./src/node.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./sdk": {
        "types": "./dist/sdk.d.mts",
        "import": "./dist/sdk.mjs"
      },
      "./app": {
        "types": "./dist/app.d.mts",
        "import": "./dist/app.mjs"
      },
      "./app-server": {
        "types": "./dist/app-server.d.mts",
        "import": "./dist/app-server.mjs"
      },
      "./app-session": {
        "types": "./dist/app-session.d.mts",
        "import": "./dist/app-session.mjs"
      },
      "./client": {
        "types": "./dist/client.d.mts",
        "import": "./dist/client.mjs"
      },
      "./react": {
        "types": "./dist/react.d.mts",
        "import": "./dist/react.mjs"
      },
      "./api": {
        "types": "./dist/api.d.mts",
        "import": "./dist/api.mjs"
      },
      "./lib": {
        "types": "./dist/lib.d.mts",
        "import": "./dist/lib.mjs"
      },
      "./expression": {
        "types": "./dist/expression.d.mts",
        "import": "./dist/expression.mjs"
      },
      "./principal": {
        "types": "./dist/principal.d.mts",
        "import": "./dist/principal.mjs"
      },
      "./stream/processor": {
        "types": "./dist/stream/processor.d.mts",
        "import": "./dist/stream/processor.mjs"
      },
      "./stream/test-support": {
        "types": "./dist/stream/test-support.d.mts",
        "import": "./dist/stream/test-support.mjs"
      },
      "./oauth-scopes": {
        "types": "./dist/oauth-scopes.d.mts",
        "import": "./dist/oauth-scopes.mjs"
      },
      "./project-ingress": {
        "types": "./dist/project-ingress.d.mts",
        "import": "./dist/project-ingress.mjs"
      },
      "./oauth": {
        "types": "./dist/oauth.d.mts",
        "import": "./dist/oauth.mjs"
      },
      "./stream/run": {
        "types": "./dist/stream/run.d.mts",
        "import": "./dist/stream/run.mjs",
        "default": "./dist/stream/run.mjs"
      },
      "./with-itx": {
        "types": "./dist/with-itx.d.mts",
        "import": "./dist/with-itx.mjs",
        "default": "./dist/with-itx.mjs"
      },
      "./node": {
        "types": "./dist/node.d.mts",
        "import": "./dist/node.mjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "capnweb": "catalog:",
    "json5": "catalog:",
    "oauth4webapi": "catalog:",
    "zod": "catalog:",
    "ws": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/ws": "catalog:"
  }
}

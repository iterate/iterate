{
  // `iterate/*` — the SDK: Worker code (Durable Objects, WorkerEntrypoints, capnweb over
  // workerd), typed against the REAL Cloudflare types in its own program, apart from the package's
  // Node/DOM program (tsconfig.json covers only the CLI entry points and what they import).
  // `typecheck` runs it; `build` runs it with emitDeclarationOnly for dist/**/*.d.ts (the .mjs
  // come from tsdown.config.ts's neutral entries).
  "files": [
    "src/sdk/index.ts",
    "src/app.ts",
    "src/app-server.ts",
    "src/app-session.ts",
    "src/client/live-state.ts",
    "src/client/react.tsx",
    "src/api.ts",
    "src/lib.ts",
    "src/expression.ts",
    "src/principal.ts",
    "src/stream/processor.ts",
    "src/stream/run.ts",
    "src/oauth-scopes.ts",
    "src/project-ingress.ts",
    "src/client/oauth.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types/experimental"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true
  }
}

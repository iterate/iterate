{
  "name": "@iterate-com/docs",
  "version": "0.1.0",
  "description": "Live co-editing for a project's docs: one processor per open doc holds its text as Yjs and autosaves it to /repos/docs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iterate/iterate",
    "directory": "packages/docs"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./install": "./src/install.ts",
    "./frames": "./src/frames.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./install": {
        "types": "./dist/install.d.mts",
        "import": "./dist/install.mjs"
      },
      "./frames": {
        "types": "./dist/frames.d.mts",
        "import": "./dist/frames.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "node-diff3": "3.2.1",
    "yjs": "^13.6.31"
  },
  "peerDependencies": {
    "iterate": "*",
    "zod": "^4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "iterate": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}

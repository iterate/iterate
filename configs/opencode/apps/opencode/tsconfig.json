{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2024", "ESNext.Disposable"],
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["*.ts"]
}

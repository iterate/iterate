{
  "name": "iterate-root",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir apps/os-next dev",
    "build": "pnpm -r --parallel build",
    "typecheck": "pnpm -r --parallel typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "os": "pnpm --dir apps/os-next",
    "preview": "pnpm --dir apps/os-next preview",
    "lint": "oxlint . --threads 1 --deny-warnings",
    "lint:check": "pnpm lint",
    "lint:fix": "oxlint . --fix",
    "test:oxlint-plugin": "pnpm --dir lint test",
    "prepare": "is-ci || husky",
    "spec": "pnpm --dir apps/os-next spec",
    "e2e": "pnpm --dir apps/os-next e2e",
    "test": "pnpm -r --parallel test"
  },
  "devDependencies": {
    "@iterate-com/shared": "workspace:*",
    "@playwright/test": "1.60.0",
    "@tanstack/eslint-plugin-router": "^1.139.0",
    "@tanstack/router-generator": "1.166.17",
    "@types/node": "^24.10.1",
    "dedent": "^1.7.0",
    "eslint-plugin-codegen": "0.34.1",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "esquery": "1.6.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "iterate": "workspace:*",
    "json5": "^2.2.3",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "pkg-pr-new": "0.0.79",
    "playwright": "1.60.0",
    "trpc-cli": "0.15.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.24.0",
  "private": true
}

{
  "name": "iterate-root",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir apps/os dev",
    "build": "pnpm -r --parallel build",
    "typecheck": "pnpm -r --parallel typecheck && pnpm typecheck:specs",
    "typecheck:specs": "tsc --noEmit -p specs/tsconfig.json",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "os": "pnpm --dir apps/os",
    "preview": "pnpm --dir apps/os preview",
    "lint": "oxlint . --threads 1 --deny-warnings",
    "lint:check": "pnpm lint",
    "lint:fix": "oxlint . --fix",
    "knip": "knip --workspace apps/os --workspace apps/kit --workspace packages/shared --workspace packages/ui --workspace packages/iterate",
    "test:oxlint-plugin": "pnpm --dir lint test",
    "prepare": "is-ci || husky",
    "spec": "playwright test --config playwright.config.ts",
    "e2e": "pnpm --dir apps/os e2e",
    "test": "pnpm -r --parallel test"
  },
  "devDependencies": {
    "@iterate-com/shared": "workspace:*",
    "@playwright/test": "1.60.0",
    "@tanstack/eslint-plugin-router": "^1.139.0",
    "@tanstack/router-generator": "1.166.17",
    "@types/node": "^24.10.1",
    "capnweb": "npm:@iterate-com/capnweb@^0.12.2",
    "dedent": "^1.7.0",
    "esbuild": "^0.27.4",
    "eslint-plugin-codegen": "0.34.1",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "esquery": "1.6.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "iterate": "workspace:*",
    "json5": "^2.2.3",
    "knip": "^6.0.5",
    "lint-staged": "^16.2.7",
    "middlewright": "https://pkg.pr.new/middlewright@e3f2374",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "pkg-pr-new": "0.0.79",
    "playwright": "1.60.0",
    "trpc-cli": "0.15.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "zod": "4.5.4"
  },
  "packageManager": "pnpm@10.24.0",
  "private": true
}

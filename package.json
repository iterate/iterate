{
  "name": "iterate-root",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir apps/os dev",
    "getin": "pnpm --dir apps/os getin",
    "os": "pnpm --dir apps/os",
    "typecheck": "pnpm -r --parallel typecheck && pnpm typecheck:specs && pnpm typecheck:configs",
    "typecheck:specs": "tsc --noEmit -p specs/tsconfig.json",
    "typecheck:configs": "tsc -p configs/default && tsc -p configs/with-agents",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint . --threads 1 --deny-warnings --report-unused-disable-directives-severity error",
    "lint:fix": "oxlint . --fix --threads 1",
    "knip": "knip",
    "prepare": "is-ci || (husky && node scripts/lockfile-stamp.ts)",
    "spec": "playwright test --config playwright.config.ts",
    "test": "pnpm -r --parallel test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@iterate-com/agents": "workspace:*",
    "@iterate-com/cli": "workspace:*",
    "@iterate-com/shared": "workspace:*",
    "@playwright/test": "catalog:",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "catalog:",
    "capnweb": "catalog:",
    "esbuild": "catalog:",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "iterate": "workspace:*",
    "knip": "^6.38.0",
    "lint-staged": "^17.5.1",
    "middlewright": "https://pkg.pr.new/middlewright@e3f2374",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "pkg-pr-new": "0.0.79",
    "playwright": "1.63.0",
    "trpc-cli": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@10.24.0",
  "private": true
}

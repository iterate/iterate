{
  "name": "iterate-root",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node scripts/os-dev.ts",
    "getin": "pnpm --dir core/os getin",
    "preview": "node scripts/os/preview.ts",
    "os:deploy": "node scripts/os/deploy.ts",
    "os:ensure-resources": "node scripts/os/ensure-resources.ts",
    "os:erase-data": "node scripts/os/erase-data.ts",
    "os:control-plane-load": "node scripts/os/control-plane-load.ts",
    "os:project-seed": "node scripts/os/project-seed.ts",
    "os:seed-instance-secrets": "node scripts/os/seed-instance-secrets.ts",
    "os:e2e-soak": "node scripts/os/e2e-soak.ts",
    "typecheck": "pnpm -r --parallel typecheck && pnpm typecheck:configs",
    "typecheck:configs": "tsc -p configs/default && tsc -p configs/heartbeat && tsc -p configs/minimal",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint . --threads 1 --deny-warnings --report-unused-disable-directives-severity error",
    "lint:fix": "oxlint . --fix --threads 1",
    "knip": "knip",
    "prepare": "is-ci || (husky && node scripts/lockfile-stamp.ts)",
    "e2e": "pnpm --dir test e2e",
    "spec": "playwright test --config test/playwright.config.ts",
    "test": "pnpm os:build && pnpm -r --parallel test",
    "os:build": "node scripts/os/build.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@iterate-com/agents": "workspace:*",
    "@iterate-com/docs": "workspace:*",
    "@iterate-com/voice": "workspace:*",
    "@playwright/test": "catalog:",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@types/node": "catalog:",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "iterate": "workspace:*",
    "knip": "^6.38.0",
    "lint-staged": "^17.5.1",
    "middlewright": "https://pkg.pr.new/middlewright@e3f2374",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "pkg-pr-new": "0.0.79",
    "playwright": "1.63.0",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "pnpm@10.24.0",
  "private": true
}
